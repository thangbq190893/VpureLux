@page "/Public/SalesOrders/{token}"
@model VPureLux.Web.Pages.Public.SalesOrders.DetailsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using System.Globalization
@{
    Layout = null;
}
@functions {
    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatMoney(decimal value)
    {
        var amount = decimal.Round(value, 0, MidpointRounding.AwayFromZero);
        return amount.ToString("#,0", Vi) + " ₫";
    }

    private static string FormatQuantity(decimal value)
    {
        if (value == decimal.Truncate(value))
        {
            return decimal.Truncate(value).ToString("0", Vi);
        }

        return value.ToString("0.####", Vi);
    }

    private static string FormatDate(DateTime value) => value.ToString("dd/MM/yyyy", Vi);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Model.InvalidLink ? L["Sales:PublicOrderInvalidTitle"] : $"{L["Sales:PublicOrderTitle"]} {Model.Order.OrderNo}")</title>
    <style>
        :root {
            color-scheme: light;
            font-family: Arial, "Helvetica Neue", sans-serif;
            color: #12344d;
            background: #eef3f7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef3f7;
        }

        .public-order-page {
            max-width: 980px;
            margin: 0 auto;
            padding: 24px 16px 40px;
        }

        .public-order-document {
            background: #fff;
            border: 1px solid #dbe3ea;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgb(15 23 42 / 8%);
            overflow: hidden;
        }

        .public-order-header {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 22px 24px;
            border-bottom: 1px solid #e5ebf0;
        }

        .public-order-brand {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0b4f7a;
        }

        .public-order-header h1 {
            margin: 8px 0 0;
            font-size: 1.45rem;
            line-height: 1.25;
        }

        .public-order-status {
            align-self: flex-start;
            padding: 6px 10px;
            border-radius: 999px;
            background: #e7f6ee;
            color: #14723b;
            font-size: .875rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .public-order-status.is-cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        .public-order-content {
            padding: 20px 24px 24px;
        }

        .public-order-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 18px;
        }

        .public-order-section {
            border: 1px solid #dbe3ea;
            border-radius: 6px;
            padding: 14px;
        }

        .public-order-section h2 {
            margin: 0 0 10px;
            font-size: .95rem;
            text-transform: uppercase;
        }

        .public-order-section dl {
            display: grid;
            grid-template-columns: 112px 1fr;
            gap: 7px 10px;
            margin: 0;
        }

        .public-order-section dt {
            color: #65798a;
        }

        .public-order-section dd {
            margin: 0;
            overflow-wrap: anywhere;
        }

        .public-order-table-wrap {
            overflow-x: auto;
        }

        .public-order-lines {
            width: 100%;
            border-collapse: collapse;
        }

        .public-order-lines th,
        .public-order-lines td {
            padding: 10px;
            border: 1px solid #dbe3ea;
            text-align: left;
            vertical-align: top;
        }

        .public-order-lines th {
            background: #f5f8fa;
            color: #21445e;
            font-size: .8rem;
            text-transform: uppercase;
        }

        .public-order-lines .number {
            text-align: right;
            white-space: nowrap;
        }

        .public-order-lines tfoot th {
            text-align: right;
        }

        .public-order-error {
            max-width: 560px;
            margin: 80px auto;
            padding: 28px;
            background: #fff;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #991b1b;
        }

        .public-order-error h1 {
            margin-top: 0;
            font-size: 1.35rem;
        }

        @@media (max-width: 720px) {
            .public-order-header {
                display: block;
            }

            .public-order-status {
                display: inline-block;
                margin-top: 12px;
            }

            .public-order-grid {
                grid-template-columns: 1fr;
            }

            .public-order-section dl {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
@if (Model.InvalidLink)
{
    <main class="public-order-page">
        <section class="public-order-error">
            <h1>@L["Sales:PublicOrderInvalidTitle"]</h1>
            <p>@L["Sales:PublicOrderInvalidMessage"]</p>
        </section>
    </main>
}
else
{
    var cancelledClass = Model.Order.Status == VPureLux.Sales.SalesOrderStatus.Cancelled ? " is-cancelled" : string.Empty;
    <main class="public-order-page">
        <article class="public-order-document">
            <header class="public-order-header">
                <div>
                    <div class="public-order-brand">@L["AppName"]</div>
                    <h1>@L["Sales:PublicOrderTitle"] @Model.Order.OrderNo</h1>
                    <div>@L["Sales:OrderDate"]: @FormatDate(Model.Order.OrderDate)</div>
                </div>
                <div class="public-order-status@cancelledClass">@L[$"Sales:Status:{Model.Order.Status}"]</div>
            </header>

            <div class="public-order-content">
                <div class="public-order-grid">
                    <section class="public-order-section">
                        <h2>@L["Sales:SellerInfo"]</h2>
                        <dl>
                            <dt>@L["Sales:SellerUnit"]</dt>
                            <dd>@L["AppName"]</dd>
                        </dl>
                    </section>

                    <section class="public-order-section">
                        <h2>@L["Sales:BuyerInfo"]</h2>
                        <dl>
                            <dt>@L["Sales:Customer"]</dt>
                            <dd>@Model.Order.CustomerDisplay</dd>
                            <dt>@L["Customers:PhoneNumber"]</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Order.CustomerPhone) ? "-" : Model.Order.CustomerPhone)</dd>
                            <dt>@L["Customers:Address"]</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Order.CustomerAddress) ? "-" : Model.Order.CustomerAddress)</dd>
                        </dl>
                    </section>
                </div>

                <div class="public-order-table-wrap">
                    <table class="public-order-lines">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Sales:ProductSku"]</th>
                            <th>@L["Sales:Quantity"]</th>
                            @if (Model.ShowPrices)
                            {
                                <th>@L["Sales:ActualPrice"]</th>
                                <th>@L["Reports:TotalAmount"]</th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.Order.Lines)
                        {
                            <tr>
                                <td>@line.LineNo</td>
                                <td>@line.ProductLabel</td>
                                <td class="number">@FormatQuantity(line.Quantity) @line.Unit</td>
                                @if (Model.ShowPrices)
                                {
                                    <td class="number">@FormatMoney(line.ActualSellingPrice)</td>
                                    <td class="number">@FormatMoney(line.RevenueAmount)</td>
                                }
                            </tr>
                        }
                        </tbody>
                        @if (Model.ShowPrices)
                        {
                            <tfoot>
                            <tr>
                                <th colspan="4">@L["Sales:PaymentTotalAmount"]</th>
                                <th class="number">@FormatMoney(Model.Order.PaymentSummary.TotalAmount)</th>
                            </tr>
                            <tr>
                                <th colspan="4">@L["Sales:PaymentPaidAmount"]</th>
                                <th class="number">@FormatMoney(Model.Order.PaymentSummary.PaidAmount)</th>
                            </tr>
                            <tr>
                                <th colspan="4">@L["Sales:PaymentRemainingAmount"]</th>
                                <th class="number">@FormatMoney(Model.Order.PaymentSummary.RemainingAmount)</th>
                            </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </article>
    </main>
}
</body>
</html>
