@page "{id:guid}"
@model VPureLux.Web.Pages.Service.DetailsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using VPureLux.Service
@{ ViewData["Title"] = Model.Order.OrderNo; }
@section scripts { <abp-script src="/Pages/Service/Details.js" /><abp-script src="/Pages/Service/Payments.js" /> }

<div class="vpl-page" data-service-details data-order-id="@Model.Order.Id" data-concurrency-stamp="@Model.Order.ConcurrencyStamp" data-manage-payments="@Model.CanManagePayments.ToString().ToLowerInvariant()">
    <form id="ServiceActionTokenForm" method="post" class="d-none">@Html.AntiForgeryToken()</form>
    <div class="vpl-page-header">
        <div>
            <h2 class="vpl-page-title mb-1">@Model.Order.OrderNo</h2>
            <div class="text-muted">@Model.Order.CustomerCode - @Model.Order.CustomerName | @Model.Order.AssetNo - @Model.Order.AssetName</div>
        </div>
        <div class="vpl-btn-toolbar">
            @if (Model.CanEdit && Model.Order.Status == ServiceOrderStatus.Draft)
            {
                <a class="btn btn-outline-primary" asp-page="/Service/Edit" asp-route-id="@Model.Order.Id"><i class="fa fa-pen" aria-hidden="true"></i> @L["Edit"]</a>
            }
            @if (Model.CanConfirm && Model.Order.Status == ServiceOrderStatus.Draft)
            {
                <button type="button" class="btn btn-primary" data-service-action="Confirm"><i class="fa fa-check" aria-hidden="true"></i> @L["Service:Confirm"]</button>
            }
            @if (Model.CanConfirm && Model.Order.Status == ServiceOrderStatus.Confirmed)
            {
                <button type="button" class="btn btn-primary" data-service-action="Start"><i class="fa fa-play" aria-hidden="true"></i> @L["Service:Start"]</button>
            }
            @if (Model.CanComplete && Model.Order.Status == ServiceOrderStatus.InProgress)
            {
                <button type="button" class="btn btn-success" id="CompleteServiceOrder"><i class="fa fa-check" aria-hidden="true"></i> @L["Service:CompleteOrder"]</button>
            }
            @if (Model.CanCancel && Model.Order.Status is ServiceOrderStatus.Draft or ServiceOrderStatus.Confirmed or ServiceOrderStatus.InProgress)
            {
                <button type="button" class="btn btn-outline-danger" id="CancelServiceOrder"><i class="fa fa-ban" aria-hidden="true"></i> @L["Service:Cancel"]</button>
            }
            <a class="btn btn-light" asp-page="/Service/Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> @L["Back"]</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-7">
            <abp-card class="vpl-card-dense h-100">
                <abp-card-body>
                    <dl class="row mb-0">
                        <dt class="col-5">@L["Service:Status"]</dt><dd class="col-7"><span class="badge @Model.StatusBadge">@L[$"Service:Status:{Model.Order.Status}"]</span></dd>
                        <dt class="col-5">@L["Service:OrderDate"]</dt><dd class="col-7">@Model.FormatDate(Model.Order.OrderDate)</dd>
                        <dt class="col-5">@L["Service:ScheduledAt"]</dt><dd class="col-7">@Model.FormatDateTime(Model.Order.ScheduledAt)</dd>
                        @if (Model.Order.CompletedAt.HasValue)
                        {
                            <dt class="col-5">@L["Service:CompletedAtLocal"]</dt><dd class="col-7">@Model.FormatDateTime(Model.Order.CompletedAt.Value.AddHours(7))</dd>
                        }
                        <dt class="col-5">@L["Service:Technician"]</dt><dd class="col-7">@(Model.Order.TechnicianName ?? "-")</dd>
                        <dt class="col-5">@L["Service:Address"]</dt><dd class="col-7">@(Model.Order.ServiceAddress ?? "-")</dd>
                        <dt class="col-5">@L["Service:Note"]</dt><dd class="col-7">@(Model.Order.Note ?? "-")</dd>
                        @if (Model.Order.Status == ServiceOrderStatus.Cancelled)
                        {
                            <dt class="col-5">@L["Service:CancellationReason"]</dt><dd class="col-7">@Model.Order.CancellationReason</dd>
                        }
                    </dl>
                </abp-card-body>
            </abp-card>
        </div>
        <div class="col-12 col-lg-5">
            <abp-card class="vpl-card-dense h-100">
                <abp-card-body>
                    <div class="text-muted mb-1">@L[Model.Order.ActualRevenueAmount.HasValue ? "Service:ActualAmount" : "Service:PlannedAmount"]</div>
                    <div class="fs-4 fw-semibold text-end">@Model.FormatMoney(Model.Order.ActualRevenueAmount ?? Model.Order.PlannedAmount)</div>
                </abp-card-body>
            </abp-card>
        </div>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-header><strong>@L["Service:Lines"]</strong></abp-card-header>
        <abp-card-body>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" style="min-width: 760px">
                    <thead><tr><th>#</th><th>@L["Service:LineType"]</th><th>@L["Service:Item"]</th><th class="text-end">@L[Model.Order.CompletedAt.HasValue ? "Service:ActualQuantity" : "Service:Quantity"]</th><th class="text-end">@L[Model.Order.CompletedAt.HasValue ? "Service:ActualUnitPrice" : "Service:UnitPrice"]</th><th class="text-end">@L[Model.Order.CompletedAt.HasValue ? "Service:ActualAmount" : "Service:Amount"]</th><th>@L["Service:LineNote"]</th></tr></thead>
                    <tbody>
                        @foreach (var line in Model.Order.Lines)
                        {
                            <tr>
                                <td>@line.LineNo</td>
                                <td><span class="badge @(line.LineType == ServiceOrderLineType.Material ? "text-bg-primary" : "text-bg-secondary")">@L[$"Service:LineType:{line.LineType}"]</span></td>
                                <td><strong>@line.ItemCode</strong> - @line.ItemName <small class="text-muted">(@line.Unit)</small></td>
                                <td class="text-end">@(Model.Order.CompletedAt.HasValue ? line.ActualQuantity : line.PlannedQuantity)</td>
                                <td class="text-end">@Model.FormatMoney(line.UnitPrice)</td>
                                <td class="text-end">@Model.FormatMoney(line.UnitPrice * (Model.Order.CompletedAt.HasValue ? line.ActualQuantity : line.PlannedQuantity))</td>
                                <td>@line.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </abp-card-body>
    </abp-card>
    <section class="mt-4 border-top pt-3" aria-labelledby="ServiceFinanceTitle">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h3 id="ServiceFinanceTitle" class="h5 mb-0">@L["Service:Payments"]</h3>
            <div class="d-flex gap-2 flex-wrap">
                @if (Model.CanCollect)
                { <button type="button" id="AddServicePayment" class="btn btn-primary"><i class="fa fa-plus" aria-hidden="true"></i> @L["Service:RecordPayment"]</button> }
                @if (Model.CanManagePayments && !Model.Money.HasInconsistentLedger && Model.Money.RefundDue > 0)
                { <button type="button" id="AddServiceRefund" class="btn btn-outline-primary"><i class="fa fa-arrow-rotate-left" aria-hidden="true"></i> @L["Service:RecordRefund"]</button> }
            </div>
        </div>
        @if (Model.Money.HasInconsistentLedger)
        { <div class="alert alert-danger">@L["VPureLux:SERVICE_032"]</div> }
        <dl class="row gy-1 mb-3">
            @if (Model.Order.Status < ServiceOrderStatus.Completed)
            {
                <dt class="col-7 col-lg-4">@L["Service:PlannedAmount"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.PlannedTotal)</dd>
                <dt class="col-7 col-lg-4">@L["Service:AdvancePaid"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.AdvancePaid)</dd>
                <dt class="col-7 col-lg-4">@L["Service:PlannedRemaining"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.PlannedRemaining)</dd>
            }
            else
            {
                @if (Model.Order.Status == ServiceOrderStatus.Completed)
                { <dt class="col-7 col-lg-4">@L["Service:ActualAmount"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.ActualTotal ?? 0)</dd> }
                <dt class="col-7 col-lg-4">@L["Service:GrossPosted"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.GrossPosted)</dd>
                <dt class="col-7 col-lg-4">@L["Service:GrossRefunded"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.GrossRefunded)</dd>
                @if (Model.Order.Status == ServiceOrderStatus.Completed && Model.Money.RefundDue == 0)
                { <dt class="col-7 col-lg-4">@L["Service:Receivable"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start">@Model.FormatMoney(Model.Money.Receivable)</dd> }
            }
            @if (Model.Money.RefundDue > 0 || Model.Order.Status == ServiceOrderStatus.Cancelled)
            { <dt class="col-7 col-lg-4 text-danger">@L["Service:RefundDue"]</dt><dd class="col-5 col-lg-8 text-end text-lg-start text-danger fw-semibold">@Model.FormatMoney(Model.Money.RefundDue)</dd> }
        </dl>
        <form id="ServiceMoneyFilters" class="d-flex flex-wrap gap-2 mb-3">
            <input id="ServiceMoneySearch" class="form-control w-auto" aria-label="@L["Service:ReferenceNo"]" placeholder="@L["Service:ReferenceNo"]" />
            <button type="submit" class="btn btn-outline-secondary" title="@L["Search"]" aria-label="@L["Search"]"><i class="fa fa-search" aria-hidden="true"></i></button>
        </form>
        <h4 class="h6">@L["Service:PaymentHistory"]</h4>
        <div class="table-responsive"><table id="ServicePaymentsTable" class="table table-sm w-100">
            <thead><tr><th>@L["Actions"]</th><th>@L["Service:MoneyDate"]</th><th>@L["Service:MoneyAmount"]</th><th>@L["Service:PaymentMethod"]</th><th>@L["Service:ReferenceNo"]</th><th>@L["Service:Status"]</th><th>@L["Service:Note"]</th><th>@L["Service:VoidReason"]</th></tr></thead>
        </table></div>
        <h4 class="h6 mt-3">@L["Service:RefundHistory"]</h4>
        <div class="table-responsive"><table id="ServiceRefundsTable" class="table table-sm w-100">
            <thead><tr><th>@L["Service:MoneyDate"]</th><th>@L["Service:MoneyAmount"]</th><th>@L["Service:PaymentMethod"]</th><th>@L["Service:ReferenceNo"]</th><th>@L["Service:RefundReason"]</th></tr></thead>
        </table></div>
    </section>
</div>
