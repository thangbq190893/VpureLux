@page
@model VPureLux.Web.Pages.Service.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using VPureLux.Service
@{ ViewData["Title"] = L["Service:Orders"]; }
@section scripts { <abp-script src="/Pages/Service/Index.js" /> }

<div class="vpl-page" data-service-index>
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Service:Orders"]</h2>
        <div class="vpl-btn-toolbar">
            @if (Model.CanManageWorks)
            {
                <a class="btn btn-outline-secondary" asp-page="/Service/Works"><i class="fa fa-list-check" aria-hidden="true"></i> @L["Service:Works"]</a>
            }
            @if (Model.CanCreate)
            {
                <a class="btn btn-primary" asp-page="/Service/Create"><i class="fa fa-plus" aria-hidden="true"></i> @L["Service:CreateOrder"]</a>
            }
        </div>
    </div>

    <abp-card class="vpl-card-dense mb-3">
        <abp-card-body>
            <form id="ServiceSearchForm" class="row g-2 align-items-end mb-0">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="ServiceSearchText">@L["Search"]</label>
                    <input id="ServiceSearchText" class="form-control form-control-sm" maxlength="256" placeholder="@L["Service:SearchPlaceholder"]" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="ServiceStatus">@L["Service:Status"]</label>
                    <select id="ServiceStatus" class="form-select form-select-sm">
                        <option value="">@L["All"]</option>
                        @foreach (var status in Enum.GetValues<ServiceOrderStatus>())
                        {
                            <option value="@((byte)status)">@L[$"Service:Status:{status}"]</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="ServiceFromDate">@L["Service:FromDate"]</label>
                    <input id="ServiceFromDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="ServiceToDate">@L["Service:ToDate"]</label>
                    <input id="ServiceToDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search" aria-hidden="true"></i> @L["Search"]</button></div>
                <div class="col-auto"><button type="button" id="ServiceClearButton" class="btn btn-light btn-sm">@L["Clear"]</button></div>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <div class="table-responsive">
                <abp-table id="ServiceOrdersTable" striped-rows="true" class="vpl-table-dense w-100" style="min-width: 880px">
                    <thead>
                        <tr>
                            <th style="width: 3rem"></th>
                            <th>@L["Service:OrderNo"]</th>
                            <th>@L["Service:OrderDate"]</th>
                            <th>@L["Service:CustomerMachine"]</th>
                            <th>@L["Service:ScheduledAt"]</th>
                            <th>@L["Service:Status"]</th>
                            <th class="text-end">@L["Service:PlannedAmount"]</th>
                        </tr>
                    </thead>
                </abp-table>
            </div>
        </abp-card-body>
    </abp-card>
</div>
