@page
@model VPureLux.Web.Pages.Sales.CustomerHistoryModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using System.Globalization

@functions {
    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatMoney(decimal value)
    {
        var amount = decimal.Round(value, 0, MidpointRounding.AwayFromZero);
        return amount.ToString("#,0", Vi) + " ₫";
    }
}

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Sales:CustomerHistory"]</h2>
    </div>

    <abp-card class="vpl-card-dense mb-3">
        <abp-card-body>
            <form method="get" class="row g-2 mb-0">
                <div class="col">
                    <label asp-for="CustomerId" class="form-label">@L["Sales:Customer"]</label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-auto d-flex align-items-end">
                    <button class="btn btn-primary">@L["Search"]</button>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    @if (Model.CustomerId.HasValue)
    {
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCustomerLabel))
        {
            <p class="vpl-page-subtitle mb-3">@L["Sales:CustomerHistoryFor", Model.SelectedCustomerLabel]</p>
        }

        <abp-card class="vpl-card-dense mb-3">
            <abp-card-header>
                <strong>@L["Sales:ReceivableSummary"]</strong>
            </abp-card-header>
            <abp-card-body>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-muted small">@L["Sales:ReceivableConfirmedSalesTotal"]</div>
                        <div class="fs-5 fw-semibold">@FormatMoney(Model.ReceivableSummary.ConfirmedSalesTotal)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">@L["Sales:ReceivablePaidTotal"]</div>
                        <div class="fs-5 fw-semibold">@FormatMoney(Model.ReceivableSummary.PaidTotal)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">@L["Sales:ReceivableRemainingDebt"]</div>
                        <div class="fs-5 fw-semibold">@FormatMoney(Model.ReceivableSummary.RemainingDebt)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">@L["Sales:ReceivableUnpaidOrderCount"]</div>
                        <div class="fs-5 fw-semibold">@Model.ReceivableSummary.UnpaidOrPartialOrderCount</div>
                    </div>
                </div>
                <div class="mt-3">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Sales/Index" asp-route-CustomerId="@Model.CustomerId">
                        @L["Sales:ViewCustomerSalesOrders"]
                    </a>
                </div>
            </abp-card-body>
        </abp-card>
    }

    @if (Model.CustomerId.HasValue && Model.Items.Count > 0)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card vpl-card-dense">
                    <div class="card-body">
                        <div class="text-muted small">@L["Sales:SummaryProductCount"]</div>
                        <div class="fs-4 fw-semibold">@Model.ProductCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card vpl-card-dense">
                    <div class="card-body">
                        <div class="text-muted small">@L["Sales:Revenue"]</div>
                        <div class="fs-4 fw-semibold">@Model.TotalRevenue</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card vpl-card-dense">
                    <div class="card-body">
                        <div class="text-muted small">@L["Sales:Profit"]</div>
                        <div class="fs-4 fw-semibold">@Model.TotalProfit</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card vpl-card-dense">
                    <div class="card-body">
                        <div class="text-muted small">@L["Sales:LastPurchaseDate"]</div>
                        <div class="fs-4 fw-semibold">@(Model.LatestPurchaseDate?.ToString("dd/MM/yyyy") ?? L["Sales:NoPurchaseHistory"].Value)</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.CustomerId.HasValue && Model.Items.Count == 0)
    {
        <div class="vpl-empty-state">@L["Sales:NoPurchaseHistory"]</div>
    }
    else if (Model.Items.Count > 0)
    {
        <abp-card class="vpl-card-dense">
            <abp-card-body>
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                    <tr>
                        <th>@L["Sales:ProductSku"]</th>
                        <th>@L["Sales:LastPurchaseDate"]</th>
                        <th>@L["Sales:LastPurchasePrice"]</th>
                        <th>@L["Sales:AveragePurchasePrice"]</th>
                        <th>@L["Sales:Revenue"]</th>
                        <th>@L["Sales:Profit"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@Model.GetProductLabel(item)</td>
                            <td>@item.LastPurchaseDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.LastPurchasePrice</td>
                            <td>@item.AveragePurchasePrice</td>
                            <td>@item.Revenue</td>
                            <td>@item.Profit</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>
    }
</div>
