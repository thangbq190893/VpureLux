@page
@model VPureLux.Web.Pages.Sales.HistoryModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    var canViewProfit = Model.CanViewProfit.ToString().ToLowerInvariant();
}

@section scripts {
    <abp-script src="/Pages/Sales/History.js" />
}

<div data-sales-history
     data-can-view-profit="@canViewProfit"></div>

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Sales:History"]</h2>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <abp-table id="SalesHistoryTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                <tr>
                    <th></th>
                    <th>@L["Sales:OrderNo"]</th>
                    <th>@L["Sales:OrderDate"]</th>
                    <th>@L["Sales:Customer"]</th>
                    <th>@L["Sales:Revenue"]</th>
                    @if (Model.CanViewProfit)
                    {
                        <th>@L["Sales:Profit"]</th>
                    }
                </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
