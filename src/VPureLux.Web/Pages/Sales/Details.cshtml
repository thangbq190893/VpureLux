@page "{id:guid}"
@model VPureLux.Web.Pages.Sales.DetailsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@using VPureLux.Permissions
@using System.Globalization
@{
    ViewData["Title"] = Model.Order.OrderNo;
    var isPrintMode = string.Equals(Request.Query["handler"], "Print", StringComparison.OrdinalIgnoreCase);
    var showPrintPrices = !isPrintMode || Model.PrintPrices;
}
@{ var canViewCost = (await AuthorizationService.AuthorizeAsync(User, null, VPureLuxPermissions.Sales.ViewCost)).Succeeded; }
@{ var canViewProfit = (await AuthorizationService.AuthorizeAsync(User, null, VPureLuxPermissions.Sales.ViewProfit)).Succeeded; }

@functions {
    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatMoney(decimal value)
    {
        var amount = decimal.Round(value, 0, MidpointRounding.AwayFromZero);
        return amount.ToString("#,0", Vi) + " ₫";
    }

    private static string FormatMoney(decimal? value)
    {
        return value.HasValue ? FormatMoney(value.Value) : string.Empty;
    }

    private static string FormatQuantity(decimal value)
    {
        if (value == decimal.Truncate(value))
        {
            return decimal.Truncate(value).ToString("0", Vi);
        }

        return value.ToString("0.####", Vi);
    }

    private static string FormatDate(DateTime value) => value.ToString("dd/MM/yyyy", Vi);
}

<div id="SalesDetailsPage"
     class="vpl-page @(isPrintMode ? "sales-print-page" : string.Empty)"
     data-sales-success-message="@Model.SuccessMessage"
     data-sales-print-mode="@isPrintMode.ToString().ToLowerInvariant()">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@Model.Order.OrderNo</h2>
        <div class="vpl-btn-toolbar sales-screen-only">
            @if (Model.CanEdit)
            {
                <a class="btn btn-sm btn-primary" asp-page="/Sales/Edit" asp-route-id="@Model.Order.Id">@L["Edit"]</a>
            }
            @if (Model.CanConfirm)
            {
                <form method="post"
                      asp-page-handler="Confirm"
                      class="d-inline"
                      data-sales-action-form
                      data-confirm-message="@L["Sales:ConfirmOrderMessage"]">
                    <input type="hidden" asp-for="Confirmation.IdempotencyKey" />
                    <button class="btn btn-sm btn-success">@L["Sales:Confirm"]</button>
                </form>
            }
            @if (Model.CanCancel)
            {
                <form method="post"
                      asp-page-handler="Cancel"
                      class="d-inline"
                      data-sales-action-form
                      data-confirm-message="@(Model.IsConfirmed ? L["Sales:CancelConfirmedUnpaidOrderMessage"] : L["Sales:CancelOrderMessage"])">
                    <button class="btn btn-sm btn-danger">@L["Sales:Cancel"]</button>
                </form>
            }
            <form method="get"
                  asp-page="/Sales/Details"
                  asp-route-id="@Model.Order.Id"
                  target="_blank"
                  class="sales-print-options">
                <input type="hidden" name="handler" value="Print" />
                <label class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" name="PrintPrices" value="true" checked />
                    <input type="hidden" name="PrintPrices" value="false" />
                    <span class="form-check-label">@L["Sales:PrintWithPrices"]</span>
                </label>
                <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Sales:PrintForTechnician"]</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ConfirmErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ConfirmErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PaymentErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.PaymentErrorMessage</div>
    }

    <abp-validation-summary />

    @if (isPrintMode)
    {
        <section class="sales-print-document">
            <div class="sales-print-title">
                <h1>@L["Sales:PrintTitle"]</h1>
                <div>@L["Sales:OrderNo"]: @Model.Order.OrderNo</div>
                <div>@L["Sales:OrderDate"]: @FormatDate(Model.Order.OrderDate)</div>
            </div>

            <div class="sales-print-parties">
                <section>
                    <h2>@L["Sales:SellerInfo"]</h2>
                    <dl>
                        <dt>@L["Sales:SellerUnit"]</dt>
                        <dd>@L["AppName"]</dd>
                    </dl>
                </section>
                <section>
                    <h2>@L["Sales:BuyerInfo"]</h2>
                    <dl>
                        <dt>@L["Sales:Customer"]</dt>
                        <dd>@Model.CustomerDisplay</dd>
                        <dt>@L["Customers:PhoneNumber"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CustomerPhoneDisplay) ? "-" : Model.CustomerPhoneDisplay)</dd>
                        <dt>@L["Customers:Address"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CustomerAddressDisplay) ? "-" : Model.CustomerAddressDisplay)</dd>
                    </dl>
                </section>
            </div>

            <table class="sales-print-lines">
                <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Sales:ProductSku"]</th>
                    <th>@L["Sales:Quantity"]</th>
                    @if (showPrintPrices)
                    {
                        <th>@L["Sales:ActualPrice"]</th>
                        <th>@L["Reports:TotalAmount"]</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Order.Lines.OrderBy(x => x.LineNo))
                {
                    <tr>
                        <td>@line.LineNo</td>
                        <td>@Model.GetProductLabel(line)</td>
                        <td>@FormatQuantity(line.Quantity) @line.UnitSnapshot</td>
                        @if (showPrintPrices)
                        {
                            <td>@FormatMoney(line.ActualSellingPrice)</td>
                            <td>@FormatMoney(line.RevenueAmount)</td>
                        }
                    </tr>
                }
                </tbody>
                @if (showPrintPrices)
                {
                    <tfoot>
                    <tr>
                        <th colspan="4">@L["Sales:PaymentTotalAmount"]</th>
                        <th>@FormatMoney(Model.IsDraft ? Model.DraftEstimatedRevenueAmount : Model.Order.TotalRevenueAmount)</th>
                    </tr>
                    </tfoot>
                }
            </table>
        </section>
    }
    else
    {
    <abp-card class="vpl-card-dense mb-3">
        <abp-card-body>
            <dl class="row mb-0">
                <dt class="col-sm-3">@L["Sales:Status"]</dt>
                <dd class="col-sm-9">@L[$"Sales:Status:{Model.Order.Status}"]</dd>
                <dt class="col-sm-3">@L["Sales:Customer"]</dt>
                <dd class="col-sm-9">@Model.CustomerDisplay</dd>
                <dt class="col-sm-3">@L["Customers:PhoneNumber"]</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.CustomerPhoneDisplay) ? "-" : Model.CustomerPhoneDisplay)</dd>
                <dt class="col-sm-3">@L["Customers:Address"]</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.CustomerAddressDisplay) ? "-" : Model.CustomerAddressDisplay)</dd>
                @if (Model.IsDraft)
                {
                    <dt class="col-sm-3">@L["Sales:DraftEstimatedRevenue"]</dt>
                    <dd class="col-sm-9">@FormatMoney(Model.DraftEstimatedRevenueAmount)</dd>
                }
                <dt class="col-sm-3">@L["Sales:ConfirmedRevenue"]</dt>
                <dd class="col-sm-9">@FormatMoney(Model.Order.TotalRevenueAmount)</dd>
                @if (canViewCost)
                {
                    <dt class="col-sm-3">@L["Sales:ConfirmedCost"]</dt>
                    <dd class="col-sm-9">@FormatMoney(Model.Order.TotalCostAmount)</dd>
                }
                @if (canViewProfit)
                {
                    <dt class="col-sm-3">@L["Sales:ConfirmedProfit"]</dt>
                    <dd class="col-sm-9">@FormatMoney(Model.Order.TotalProfitAmount)</dd>
                }
                @if (Model.IsDraft)
                {
                    <dt class="col-sm-3">@L["Sales:FinancialTotals"]</dt>
                    <dd class="col-sm-9 text-muted">@L["Sales:DraftFinancialTotalsNote"]</dd>
                }
            </dl>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-card-dense mb-3">
        <abp-card-header>
            <strong>@L["Sales:PaymentSummary"]</strong>
        </abp-card-header>
        <abp-card-body>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">@L["Sales:PaymentTotalAmount"]</div>
                    <div class="fs-5 fw-semibold">@FormatMoney(Model.Order.PaymentSummary.TotalAmount)</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">@L["Sales:PaymentPaidAmount"]</div>
                    <div class="fs-5 fw-semibold">@FormatMoney(Model.Order.PaymentSummary.PaidAmount)</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">@L["Sales:PaymentRemainingAmount"]</div>
                    <div class="fs-5 fw-semibold">@FormatMoney(Model.Order.PaymentSummary.RemainingAmount)</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">@L["Sales:PaymentStatus"]</div>
                    <div class="fs-5 fw-semibold">@L[$"Sales:PaymentStatus:{Model.Order.PaymentSummary.PaymentStatus}"]</div>
                </div>
            </div>
        </abp-card-body>
    </abp-card>

    @if (Model.CanAddPayment)
    {
        <abp-card class="vpl-card-dense mb-3">
            <abp-card-header>
                <strong>@L["Sales:AddPayment"]</strong>
            </abp-card-header>
            <abp-card-body>
                <form method="post" asp-page-handler="AddPayment" asp-route-id="@Model.Order.Id" class="row g-2">
                    <input type="hidden" asp-for="Payment.IdempotencyKey" />
                    <div class="col-md-2">
                        <label asp-for="Payment.Amount" class="form-label">@L["Sales:PaymentAmount"]</label>
                        <input asp-for="Payment.Amount"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               value="@(Model.Payment.Amount > 0 ? Model.Payment.Amount.ToString("0.##", CultureInfo.InvariantCulture) : string.Empty)" />
                        <span asp-validation-for="Payment.Amount" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Payment.PaymentDate" class="form-label">@L["Sales:PaymentDate"]</label>
                        <input asp-for="Payment.PaymentDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                        <span asp-validation-for="Payment.PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Payment.PaymentMethod" class="form-label">@L["Sales:PaymentMethod"]</label>
                        <select asp-for="Payment.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
                        <span asp-validation-for="Payment.PaymentMethod" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Payment.ReferenceNo" class="form-label">@L["Sales:PaymentReferenceNo"]</label>
                        <input asp-for="Payment.ReferenceNo" class="form-control" />
                        <span asp-validation-for="Payment.ReferenceNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Payment.Note" class="form-label">@L["Sales:PaymentNote"]</label>
                        <input asp-for="Payment.Note" class="form-control" />
                        <span asp-validation-for="Payment.Note" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-sm btn-primary">@L["Sales:AddPayment"]</button>
                    </div>
                </form>
            </abp-card-body>
        </abp-card>
    }

    <abp-card class="vpl-card-dense mb-3">
        <abp-card-header>
            <strong>@L["Sales:PaymentHistory"]</strong>
        </abp-card-header>
        <abp-card-body>
            @if (Model.Payments.Count == 0)
            {
                <div class="vpl-empty-state">@L["Sales:NoPaymentHistory"]</div>
            }
            else
            {
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                    <tr>
                        <th>@L["Sales:PaymentDate"]</th>
                        <th>@L["Sales:PaymentAmount"]</th>
                        <th>@L["Sales:PaymentMethod"]</th>
                        <th>@L["Sales:PaymentReferenceNo"]</th>
                        <th>@L["Sales:PaymentNote"]</th>
                        <th>@L["Sales:PaymentRowStatus"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>@FormatDate(payment.PaymentDate)</td>
                            <td>@FormatMoney(payment.Amount)</td>
                            <td>@L[$"Sales:PaymentMethod:{payment.PaymentMethod}"]</td>
                            <td>@payment.ReferenceNo</td>
                            <td>@payment.Note</td>
                            <td>@L[$"Sales:PaymentRowStatus:{payment.Status}"]</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            }
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-card-dense mb-3">
        <abp-card-body>
            <abp-table striped-rows="true" class="vpl-table-dense">
                <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Sales:ProductSku"]</th>
                    <th>@L["Sales:Quantity"]</th>
                    <th>@L["Sales:SuggestedPrice"]</th>
                    <th>@L["Sales:ActualPrice"]</th>
                    <th>@L["Sales:OverrideReason"]</th>
                    @if (canViewCost)
                    {
                        <th>@L["Sales:CostPrice"]</th>
                        <th>@L["Sales:Cost"]</th>
                    }
                    @if (canViewProfit)
                    {
                        <th>@L["Sales:Profit"]</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Order.Lines)
                {
                    <tr>
                        <td>@line.LineNo</td>
                        <td>
                            <div>@Model.GetProductLabel(line)</div>
                            <span class="@Model.GetBomBadgeClass(line)">@Model.GetBomStatusText(line)</span>
                            @if (line.BomSnapshotItems.Count > 0)
                            {
                                <ul class="mb-0 mt-1 small text-muted">
                                @foreach (var item in line.BomSnapshotItems)
                                {
                                    <li>@item.ComponentCode - @item.ComponentName: @FormatQuantity(item.TotalRequiredQuantity) @item.Unit</li>
                                }
                                </ul>
                            }
                        </td>
                        <td>@FormatQuantity(line.Quantity)</td>
                        <td>@FormatMoney(line.SuggestedPriceSnapshot)</td>
                        <td>@FormatMoney(line.ActualSellingPrice)</td>
                        <td>@line.OverrideReason</td>
                        @if (canViewCost)
                        {
                            if (Model.IsDraft)
                            {
                                <td class="text-muted">@L["Sales:CalculatedAfterConfirmation"]</td>
                                <td class="text-muted">@L["Sales:CalculatedAfterConfirmation"]</td>
                            }
                            else
                            {
                                <td>@FormatMoney(line.CostPriceSnapshot)</td>
                                <td>@FormatMoney(line.CostAmountSnapshot)</td>
                            }
                        }
                        @if (canViewProfit)
                        {
                            if (Model.IsDraft)
                            {
                                <td class="text-muted">@L["Sales:CalculatedAfterConfirmation"]</td>
                            }
                            else
                            {
                                <td>@FormatMoney(line.ProfitAmount)</td>
                            }
                        }
                    </tr>
                }
                </tbody>
            </abp-table>
        </abp-card-body>
    </abp-card>
    }

    <a class="btn btn-sm btn-secondary sales-screen-only" asp-page="/Sales/Index">@L["Back"]</a>
</div>

@section styles {
    <style>
        .sales-print-options {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .sales-print-document {
            max-width: 960px;
            margin: 0 auto;
            color: #111827;
            background: #fff;
        }

        .sales-print-title {
            margin-bottom: 1.25rem;
            text-align: center;
        }

        .sales-print-title h1 {
            margin-bottom: .5rem;
            font-size: 1.45rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sales-print-parties {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .sales-print-parties section {
            padding: .75rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
        }

        .sales-print-parties h2 {
            margin-bottom: .5rem;
            font-size: .95rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sales-print-parties dl {
            display: grid;
            grid-template-columns: 7rem 1fr;
            gap: .25rem .5rem;
            margin-bottom: 0;
        }

        .sales-print-parties dt {
            font-weight: 600;
        }

        .sales-print-parties dd {
            margin-bottom: 0;
        }

        .sales-print-lines {
            width: 100%;
            border-collapse: collapse;
        }

        .sales-print-lines th,
        .sales-print-lines td {
            padding: .5rem;
            border: 1px solid #d1d5db;
            vertical-align: top;
        }

        .sales-print-lines th {
            background: #f3f4f6;
            font-weight: 700;
        }

        .sales-print-lines tfoot th {
            text-align: right;
        }

        @@media print {
            .lpx-sidebar-container,
            .lpx-toolbar,
            .sales-screen-only,
            footer {
                display: none !important;
            }

            body {
                background: #fff !important;
            }

            .sales-print-page {
                margin: 0;
            }

            .sales-print-document {
                max-width: none;
            }

            .sales-print-parties section {
                break-inside: avoid;
            }
        }

        @@media (max-width: 767.98px) {
            .sales-print-options {
                flex-wrap: wrap;
            }

            .sales-print-parties {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section scripts {
    <abp-script src="/Pages/Sales/Details.js" />
}
