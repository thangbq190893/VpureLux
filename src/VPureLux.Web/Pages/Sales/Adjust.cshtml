@page "{id:guid}"
@model VPureLux.Web.Pages.Sales.AdjustModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using System.Globalization
@using VPureLux.Sales
@{
    ViewData["Title"] = L["Sales:AdjustConfirmedOrder"];
    var savedMessage = TempData["SalesAdjustmentMessage"] as string;
}

<div id="SalesAdjustPage"
     class="vpl-page"
     data-product-lookup-url="@Url.Page(null, "ProductLookup", new { id = Model.Id })"
     data-product-context-url="@Url.Page(null, "ProductContext", new { id = Model.Id })">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Sales:AdjustConfirmedOrder"] - @Model.Order.OrderNo</h2>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Sales/Details" asp-route-id="@Model.Id">@L["Back"]</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(savedMessage))
    {
        <div class="alert alert-success">@savedMessage</div>
    }
    <abp-validation-summary />

    @if (!Model.RevisionId.HasValue)
    {
        <abp-card class="vpl-card-dense">
            <abp-card-header><strong>@L["Sales:AdjustmentReasonTitle"]</strong></abp-card-header>
            <abp-card-body>
                <form method="post" asp-page-handler="Start" class="row g-2">
                    <div class="col-md-9">
                        <abp-input asp-for="StartInput.Reason" label="@L["Sales:AdjustmentReason"]" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary" type="submit">@L["Sales:StartAdjustment"]</button>
                    </div>
                </form>
            </abp-card-body>
        </abp-card>
    }
    else if (Model.Revision != null && Model.Preview != null)
    {
        <form id="SalesAdjustmentForm" method="post" asp-page-handler="Save">
            <input asp-for="RevisionId" type="hidden" />
            <input asp-for="UpdateInput.CustomerId" type="hidden" />
            <abp-card class="vpl-card-dense mb-3">
                <abp-card-header>
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                        <strong>@L["Sales:AdjustedLines"]</strong>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-adjustment-line>
                            <i class="fa fa-plus"></i> @L["Sales:AddLine"]
                        </button>
                    </div>
                </abp-card-header>
                <abp-card-body>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr>
                                <th style="width: 44px"></th>
                                <th>@L["Sales:ProductSku"]</th>
                                <th style="width: 130px">@L["Sales:Quantity"]</th>
                                <th style="width: 180px">@L["Sales:ActualPrice"]</th>
                                <th>@L["Sales:OverrideReason"]</th>
                            </tr>
                            </thead>
                            <tbody data-adjustment-lines>
                            @for (var i = 0; i < Model.UpdateInput.Lines.Count; i++)
                            {
                                var inputLine = Model.UpdateInput.Lines[i];
                                var revisionLine = Model.Revision.Lines.FirstOrDefault(x => x.Id == inputLine.RevisionLineId);
                                var productText = revisionLine == null
                                    ? inputLine.ProductId.ToString("D")
                                    : $"{revisionLine.ProductCode} - {revisionLine.ProductName}";
                                <tr data-adjustment-line class="@(inputLine.IsRemoved ? "d-none" : string.Empty)">
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-adjustment-line title="@L["Delete"]">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <input name="UpdateInput.Lines[@i].RevisionLineId" value="@inputLine.RevisionLineId" type="hidden" data-line-id />
                                        <input name="UpdateInput.Lines[@i].IsRemoved" value="@inputLine.IsRemoved.ToString().ToLowerInvariant()" type="hidden" data-line-removed />
                                        <select name="UpdateInput.Lines[@i].ProductId" class="w-100" data-product-select required>
                                            <option value="@inputLine.ProductId" selected>@productText</option>
                                        </select>
                                        <div class="small text-danger d-none" data-product-warning>@L["Sales:NoPublishedBom"]</div>
                                    </td>
                                    <td><input name="UpdateInput.Lines[@i].Quantity" value="@inputLine.Quantity.ToString("0.####", CultureInfo.InvariantCulture)" class="form-control form-control-sm" type="number" min="0.0001" step="0.0001" required /></td>
                                    <td><input name="UpdateInput.Lines[@i].ActualSellingPrice" value="@inputLine.ActualSellingPrice.ToString("0.##", CultureInfo.InvariantCulture)" class="form-control form-control-sm" type="number" min="0" step="0.01" required /></td>
                                    <td><input name="UpdateInput.Lines[@i].OverrideReason" value="@inputLine.OverrideReason" class="form-control form-control-sm" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <template data-adjustment-line-template>
                        <tr data-adjustment-line>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-adjustment-line title="@L["Delete"]"><i class="fa fa-trash"></i></button></td>
                            <td>
                                <input name="UpdateInput.Lines[__index__].RevisionLineId" type="hidden" data-line-id />
                                <input name="UpdateInput.Lines[__index__].IsRemoved" value="false" type="hidden" data-line-removed />
                                <select name="UpdateInput.Lines[__index__].ProductId" class="w-100" data-product-select required></select>
                                <div class="small text-danger d-none" data-product-warning>@L["Sales:NoPublishedBom"]</div>
                            </td>
                            <td><input name="UpdateInput.Lines[__index__].Quantity" value="1" class="form-control form-control-sm" type="number" min="0.0001" step="0.0001" required /></td>
                            <td><input name="UpdateInput.Lines[__index__].ActualSellingPrice" class="form-control form-control-sm" type="number" min="0" step="0.01" required /></td>
                            <td><input name="UpdateInput.Lines[__index__].OverrideReason" class="form-control form-control-sm" /></td>
                        </tr>
                    </template>
                </abp-card-body>
            </abp-card>

            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-success" type="submit" asp-page-handler="Confirm" data-confirm-adjustment>
                    <i class="fa fa-check"></i> @L["Sales:ConfirmAdjustment"]
                </button>
                <button class="btn btn-outline-danger" type="submit" asp-page-handler="Discard" formnovalidate data-discard-adjustment>
                    @L["Sales:DiscardAdjustment"]
                </button>
            </div>
        </form>

        <abp-card class="vpl-card-dense">
            <abp-card-header><strong>@L["Sales:AdjustmentPreview"]</strong></abp-card-header>
            <abp-card-body>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><span class="text-muted">@L["Sales:BeforeTotal"]</span><br /><strong>@Model.FormatMoney(Model.Preview.BeforeTotal)</strong></div>
                    <div class="col-md-3"><span class="text-muted">@L["Sales:NewTotal"]</span><br /><strong>@Model.FormatMoney(Model.Preview.NewTotal)</strong></div>
                    <div class="col-md-3"><span class="text-muted">@L["Sales:PaymentRemainingAmount"]</span><br /><strong>@Model.FormatMoney(Model.Preview.RemainingAmount)</strong></div>
                    <div class="col-md-3"><span class="text-muted">@L["Sales:RefundDue"]</span><br /><strong>@Model.FormatMoney(Model.Preview.RefundDue)</strong></div>
                </div>
                @if (Model.Preview.PendingReturnCount > 0)
                {
                    <div class="alert alert-warning">@L["Sales:WarehouseConfirmationRequired", Model.Preview.PendingReturnCount]</div>
                }
                <abp-table striped-rows="true" class="vpl-table-dense mb-0">
                    <thead><tr><th>@L["Sales:InventoryImpact"]</th><th>@L["Sales:ProductSku"]</th><th class="text-end">@L["Sales:Quantity"]</th></tr></thead>
                    <tbody>
                    @foreach (var impact in Model.Preview.Impacts)
                    {
                        <tr>
                            <td>@L[$"Sales:RevisionImpact:{impact.ImpactType}"]</td>
                            <td>@impact.ItemCode - @impact.ItemName</td>
                            <td class="text-end">@impact.Quantity.ToString("0.####", CultureInfo.GetCultureInfo("vi-VN"))</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>
    }
</div>

@section scripts {
    <abp-script src="/Pages/Sales/Adjust.js" />
}
