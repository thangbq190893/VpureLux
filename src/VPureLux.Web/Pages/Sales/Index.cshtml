@page
@model VPureLux.Web.Pages.Sales.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@using VPureLux.Permissions
@using VPureLux.Sales
@{
    ViewData["Title"] = L["Sales:Title"];
    var canViewCustomerHistory = Model.CanViewHistory && (await AuthorizationService.AuthorizeAsync(User, null, VPureLuxPermissions.Sales.ViewProfit)).Succeeded;
}

@section scripts {
    <abp-script src="/Pages/Sales/Index.js" />
}

<div class="vpl-page vpl-inquiry-page">
    <form id="SalesCancelTokenForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Sales:Title"]</h2>
        <div class="vpl-btn-toolbar">
            @if (canViewCustomerHistory)
            {
                <a class="btn btn-outline-secondary" asp-page="/Sales/CustomerHistory">@L["Sales:CustomerHistory"]</a>
            }
            <a class="btn btn-outline-secondary" asp-page="/Sales/History">@L["Sales:History"]</a>
            @if (Model.CanCreate)
            {
                <a class="btn btn-primary" asp-page="/Sales/Create">@L["Sales:Create"]</a>
            }
        </div>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-body>
            <form id="SalesSearchForm" class="row g-2 align-items-end mb-0">
                @if (Model.CustomerId.HasValue)
                {
                    <input type="hidden" asp-for="CustomerId" id="SalesCustomerId" />
                }
                @if (Model.Status.HasValue)
                {
                    <input type="hidden" asp-for="Status" id="SalesStatus" />
                }
                <div class="col-md-4">
                    <label asp-for="PaymentStatus" class="form-label">@L["Sales:PaymentStatus"]</label>
                    <select asp-for="PaymentStatus" id="SalesPaymentStatus" class="form-select form-select-sm">
                        <option value="">@L["Select"]</option>
                        <option value="@SalesOrderReceivableStatus.NotApplicable">@L["Sales:PaymentStatus:NotApplicable"]</option>
                        <option value="@SalesOrderReceivableStatus.Unpaid">@L["Sales:PaymentStatus:Unpaid"]</option>
                        <option value="@SalesOrderReceivableStatus.PartiallyPaid">@L["Sales:PaymentStatus:PartiallyPaid"]</option>
                        <option value="@SalesOrderReceivableStatus.Paid">@L["Sales:PaymentStatus:Paid"]</option>
                        <option value="@SalesOrderReceivableStatus.Overpaid">@L["Sales:PaymentStatus:Overpaid"]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">@L["Search"]</button>
                </div>
                @if (Model.PaymentStatus.HasValue || Model.CustomerId.HasValue || Model.Status.HasValue)
                {
                    <div class="col-auto">
                        <a class="btn btn-outline-secondary btn-sm" asp-page="/Sales/Index">@L["Sales:ClearFilters"]</a>
                    </div>
                }
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense">
        <abp-card-body>
            <abp-table id="SalesOrdersTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                    <tr>
                        <th></th>
                        <th>@L["Sales:OrderNo"]</th>
                        <th>@L["Sales:OrderDate"]</th>
                        <th>@L["Sales:Customer"]</th>
                        <th>@L["Sales:Status"]</th>
                        <th>@L["Sales:Revenue"]</th>
                        <th class="text-end">@L["Sales:PaymentTotalAmount"]</th>
                        <th class="text-end">@L["Sales:PaymentPaidAmount"]</th>
                        <th class="text-end">@L["Sales:PaymentRemainingAmount"]</th>
                        <th>@L["Sales:PaymentStatus"]</th>
                    </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
