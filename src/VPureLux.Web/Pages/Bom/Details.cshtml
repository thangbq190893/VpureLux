@page "{id:guid}"
@model VPureLux.Web.Pages.Bom.DetailsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Bom:Details"];
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_8"><h2>@L["Bom:Details"]</h2></abp-column>
            <abp-column size-md="_4" class="text-end">
                @if (Model.CanEdit)
                {
                    <a class="btn btn-primary" asp-page="/Bom/Edit" asp-route-id="@Model.BomVersion.Id">@L["Edit"]</a>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <dl class="row">
            <dt class="col-sm-3">@L["Bom:Product"]</dt><dd class="col-sm-9">@Model.ProductLabel</dd>
            <dt class="col-sm-3">@L["Bom:VersionNo"]</dt><dd class="col-sm-9">@Model.BomVersion.VersionNo</dd>
            <dt class="col-sm-3">@L["Bom:Status"]</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.BomVersion.Status == VPureLux.Bom.BomStatus.Published ? "bg-success" : Model.BomVersion.Status == VPureLux.Bom.BomStatus.Archived ? "bg-secondary" : "bg-warning text-dark")"
                      data-bom-version-status>
                    @L[$"Bom:Status:{Model.BomVersion.Status}"]
                </span>
                @if (Model.BomVersion.Status == VPureLux.Bom.BomStatus.Published)
                {
                    <span class="badge bg-primary ms-1">@L["Bom:CurrentVersionBadge"]</span>
                }
            </dd>
            <dt class="col-sm-3">@L["Bom:EffectiveFrom"]</dt><dd class="col-sm-9">@VPureLux.Web.Pages.Bom.BomUi.FormatDate(Model.BomVersion.EffectiveFrom)</dd>
            <dt class="col-sm-3">@L["Bom:EffectiveTo"]</dt><dd class="col-sm-9">@VPureLux.Web.Pages.Bom.BomUi.FormatDate(Model.BomVersion.EffectiveTo)</dd>
            <dt class="col-sm-3">@L["Bom:StandardCostRange"]</dt>
            <dd class="col-sm-9">
                @if (Model.StandardCost.HasCompleteCost)
                {
                    @VPureLux.Web.Pages.Bom.BomUi.FormatMoneyRange(Model.StandardCost.MinTotalCost!.Value, Model.StandardCost.MaxTotalCost!.Value)
                }
                else
                {
                    <span class="text-warning">@L["Bom:MissingInventoryCost", Model.StandardCost.MissingComponentCount]</span>
                }
            </dd>
        </dl>
        <abp-table striped-rows="true">
            <thead>
            <tr>
                <th class="text-center" style="width: 56px;">#</th>
                <th>@L["Bom:Component"]</th>
                <th>@L["Bom:Quantity"]</th>
                <th class="text-end">@L["Bom:MinUnitCost"]</th>
                <th class="text-end">@L["Bom:MaxUnitCost"]</th>
                <th class="text-end">@L["Bom:MinLineCost"]</th>
                <th class="text-end">@L["Bom:MaxLineCost"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.BomVersion.Items)
            {
                var costItem = Model.GetStandardCostItem(item.Id);
                <tr>
                    <td class="text-center text-muted">@item.LineNo</td>
                    <td>@Model.GetComponentLabel(item.ComponentId)</td>
                    <td>@VPureLux.Web.Pages.Bom.BomUi.FormatQuantity(item.Quantity)</td>
                    @if (costItem?.HasAvailableInventoryCost == true)
                    {
                        <td class="text-end">@VPureLux.Web.Pages.Bom.BomUi.FormatMoney(costItem.MinUnitCost!.Value)</td>
                        <td class="text-end">@VPureLux.Web.Pages.Bom.BomUi.FormatMoney(costItem.MaxUnitCost!.Value)</td>
                        <td class="text-end">@VPureLux.Web.Pages.Bom.BomUi.FormatMoney(costItem.MinLineCost!.Value)</td>
                        <td class="text-end">@VPureLux.Web.Pages.Bom.BomUi.FormatMoney(costItem.MaxLineCost!.Value)</td>
                    }
                    else
                    {
                        <td colspan="4" class="text-warning text-end">@L["Bom:NoAvailableInventoryCost"]</td>
                    }
                </tr>
            }
            </tbody>
        </abp-table>
        <a class="btn btn-secondary" asp-page="/Bom/Product" asp-route-productId="@Model.BomVersion.ProductId">@L["Back"]</a>
    </abp-card-body>
</abp-card>
