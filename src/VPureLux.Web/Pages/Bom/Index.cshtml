@page
@model VPureLux.Web.Pages.Bom.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Bom:Title"];
    var canCreate = Model.CanCreate.ToString().ToLowerInvariant();
}

@section scripts {
    <abp-script src="/Pages/Bom/Index.js" />
}

@section styles {
    <abp-style src="/Pages/Bom/Index.css" />
}

<div data-bom-index
     data-can-create="@canCreate"></div>

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Bom:Title"]</h2>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <form id="BomSearchForm" class="row g-2 align-items-end mb-3" data-bom-search-form>
                <div class="col-md-6 col-lg-5">
                    <label asp-for="SearchTerm" class="form-label">@L["Bom:SearchProducts"]</label>
                    <input asp-for="SearchTerm" id="BomSearchTerm" class="form-control" placeholder="@L["Bom:SearchPlaceholder"]" />
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary" type="submit">@L["Bom:ApplySearch"]</button>
                    <button class="btn btn-secondary" type="button" id="BomClearButton">@L["Bom:ClearSearch"]</button>
                </div>
            </form>

            <abp-table id="BomProductsTable" striped-rows="true" class="vpl-table-dense bom-summary-table" data-bom-summary-table>
                <thead>
                <tr>
                    <th class="bom-product-column">@L["Bom:Product"]</th>
                    <th class="bom-state-column">@L["Bom:BomState"]</th>
                    <th class="bom-standard-cost-column">@L["Bom:StandardCostRange"]</th>
                    <th class="bom-actions-column text-end">@L["Actions"]</th>
                </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
