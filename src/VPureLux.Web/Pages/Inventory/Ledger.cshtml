@page
@model VPureLux.Web.Pages.Inventory.LedgerModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L

@section scripts {
    <abp-script src="/Pages/Inventory/Ledger.js" />
}

<div class="vpl-page vpl-inquiry-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Inventory:Ledger"]</h2>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-header>
            <h5 class="mb-0">@L["Search"]</h5>
        </abp-card-header>
        <abp-card-body>
            <form method="get" id="InventoryLedgerSearchForm" class="row g-2 mb-0">
                <div class="col-md-3">
                    <label asp-for="WarehouseId" class="form-label">@L["Inventory:Warehouse"]</label>
                    <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" id="InventoryLedgerWarehouseId" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="StockItemId" class="form-label">@L["Inventory:StockItem"]</label>
                    <select asp-for="StockItemId" asp-items="Model.StockItemOptions" id="InventoryLedgerStockItemId" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Type" class="form-label">@L["Inventory:Type"]</label>
                    <select asp-for="Type" id="InventoryLedgerType" class="form-select">
                        <option value="">@L["Inventory:AllTransactionTypes"]</option>
                        @foreach (var type in Model.TransactionTypes)
                        {
                            if (Model.Type == type)
                            {
                                <option value="@type" selected="selected">@L[$"Inventory:TransactionType:{type}"]</option>
                            }
                            else
                            {
                                <option value="@type">@L[$"Inventory:TransactionType:{type}"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="SourceReference" class="form-label">@L["Inventory:SourceReference"]</label>
                    <input asp-for="SourceReference" id="InventoryLedgerSourceReference" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="FromDate" class="form-label">@L["Inventory:FromDate"]</label>
                    <input asp-for="FromDate" type="date" id="InventoryLedgerFromDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ToDate" class="form-label">@L["Inventory:ToDate"]</label>
                    <input asp-for="ToDate" type="date" id="InventoryLedgerToDate" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">@L["Inventory:ApplyFilter"]</button>
                    <a class="btn btn-outline-secondary" asp-page="/Inventory/Ledger">@L["Inventory:ClearFilter"]</a>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense">
        <abp-card-body>
            <div class="vpl-empty-state d-none" data-inventory-empty-state>@L["Inventory:NoLedgerEntries"]</div>
            <abp-table id="InventoryLedgerTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                    <tr>
                        <th>@L["Inventory:PostedAt"]</th>
                        <th>@L["Inventory:Warehouse"]</th>
                        <th>@L["Inventory:Material"]</th>
                        <th>@L["Inventory:Type"]</th>
                        <th>@L["Inventory:SourceReference"]</th>
                        <th>@L["Inventory:QuantityIn"]</th>
                        <th>@L["Inventory:QuantityOut"]</th>
                        <th>@L["Inventory:UnitCost"]</th>
                        <th>@L["Inventory:Amount"]</th>
                        <th>@L["Inventory:Reason"]</th>
                    </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
