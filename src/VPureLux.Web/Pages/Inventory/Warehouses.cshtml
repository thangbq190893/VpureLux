@page
@model VPureLux.Web.Pages.Inventory.WarehousesModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{ ViewData["Title"] = L["Inventory:Warehouses"]; }

@section scripts {
    <abp-script src="/Pages/Inventory/Warehouses.js" />
}

<div data-warehouses-page
     data-status-success="@(string.IsNullOrWhiteSpace(Model.StatusMessageKey) ? string.Empty : L[Model.StatusMessageKey].Value)"></div>

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Inventory:Warehouses"]</h2>
    </div>

    <abp-card class="vpl-card-dense mb-4">
        <abp-card-body>
            <h5 class="mb-3">@L["Create"]</h5>
            <form method="post" data-warehouse-create-form>
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <abp-row class="align-items-end">
                    <abp-column size-md="_3">
                        <label asp-for="NewWarehouse.Code" class="form-label">@L["Inventory:Code"]</label>
                        <input asp-for="NewWarehouse.Code" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewWarehouse.Code"></span>
                    </abp-column>
                    <abp-column size-md="_3">
                        <label asp-for="NewWarehouse.Name" class="form-label">@L["Inventory:Name"]</label>
                        <input asp-for="NewWarehouse.Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewWarehouse.Name"></span>
                    </abp-column>
                    <abp-column size-md="_4">
                        <label asp-for="NewWarehouse.Address" class="form-label">@L["Inventory:Address"]</label>
                        <input asp-for="NewWarehouse.Address" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewWarehouse.Address"></span>
                    </abp-column>
                    <abp-column size-md="_2">
                        <button type="submit" class="btn btn-primary w-100">@L["Create"]</button>
                    </abp-column>
                </abp-row>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <abp-table striped-rows="true" class="vpl-table-dense">
                <thead>
                <tr>
                    <th>@L["Inventory:Code"]</th>
                    <th>@L["Inventory:Name"]</th>
                    <th>@L["Inventory:Address"]</th>
                    <th>@L["Inventory:Status"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var x in Model.Warehouses)
                {
                    <tr>
                        <td>@x.Code</td>
                        <td>@x.Name</td>
                        <td>@x.Address</td>
                        <td>@L[$"Status:{x.Status}"]</td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-warehouse-edit-button
                                    data-id="@x.Id"
                                    data-name="@x.Name"
                                    data-address="@x.Address">
                                @L["Edit"]
                            </button>
                            <form method="post"
                                  asp-page-handler="@(x.Status == VPureLux.Inventory.InventoryEntityStatus.Active ? "Deactivate" : "Activate")"
                                  asp-route-id="@x.Id"
                                  class="d-inline"
                                  data-warehouse-status-form
                                  data-confirm-message="@(x.Status == VPureLux.Inventory.InventoryEntityStatus.Active ? L["Inventory:ConfirmDeactivateWarehouse"].Value : L["Inventory:ConfirmActivateWarehouse"].Value)">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(x.Status == VPureLux.Inventory.InventoryEntityStatus.Active ? L["Deactivate"] : L["Activate"])
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </abp-table>
        </abp-card-body>
    </abp-card>

    <div class="modal fade" id="WarehouseEditModal" tabindex="-1" aria-labelledby="WarehouseEditModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Update" data-warehouse-edit-form>
                    <div class="modal-header">
                        <h5 class="modal-title" id="WarehouseEditModalLabel">@L["Inventory:UpdateWarehouse"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <input asp-for="EditWarehouse.Id" type="hidden" data-warehouse-edit-id />
                        <div class="mb-3">
                            <label asp-for="EditWarehouse.Name" class="form-label">@L["Inventory:Name"]</label>
                            <input asp-for="EditWarehouse.Name" class="form-control" autocomplete="off" data-warehouse-edit-name />
                            <span asp-validation-for="EditWarehouse.Name"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EditWarehouse.Address" class="form-label">@L["Inventory:Address"]</label>
                            <input asp-for="EditWarehouse.Address" class="form-control" autocomplete="off" data-warehouse-edit-address />
                            <span asp-validation-for="EditWarehouse.Address"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@L["Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
