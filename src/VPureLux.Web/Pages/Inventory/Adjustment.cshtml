@page
@model VPureLux.Web.Pages.Inventory.AdjustmentModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using System.Globalization
@{
    ViewData["Title"] = L["Inventory:Adjustment"];
    var postSuccessMessageKey = TempData["InventoryPostSuccessMessage"] as string;
}

@functions {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private static string FormatQuantity(decimal value)
    {
        if (value == decimal.Truncate(value))
        {
            return decimal.Truncate(value).ToString("0", Invariant);
        }

        return value.ToString("0.####", Invariant);
    }

    private static string FormatNullableQuantity(decimal? value)
    {
        return value.HasValue ? FormatQuantity(value.Value) : string.Empty;
    }
}

<div data-inventory-posting-page
     data-count-adjustment-page
     data-post-success="@(postSuccessMessageKey == null ? null : L[postSuccessMessageKey].Value)"
     data-increase-label="@L["Inventory:TransactionType:AdjustmentIncrease"]"
     data-decrease-label="@L["Inventory:TransactionType:AdjustmentDecrease"]"
     data-no-change-label="@L["Inventory:NoChange"]">
    <h2>@L["Inventory:Adjustment"]</h2>
</div>

<script type="application/json" id="adjustment-balance-data">@Html.Raw(Model.BalanceQuantitiesJson)</script>

<abp-card class="vpl-entry-surface">
    <abp-card-body>
        <form method="post" data-inventory-posting-form data-confirm-message="@L["Inventory:ConfirmPostAdjustment"]">
            <input asp-for="IdempotencyKey" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="WarehouseId" class="form-label">@L["Inventory:Warehouse"]</label>
                <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" class="form-select" data-adjustment-warehouse>
                    <option value="">@L["Select"]</option>
                </select>
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ReasonCategory" class="form-label">@L["Inventory:AdjustmentReasonCategory"]</label>
                    <select asp-for="ReasonCategory" asp-items="Model.ReasonCategoryOptions" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                    <span asp-validation-for="ReasonCategory" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="ReasonDetail" class="form-label">@L["Inventory:AdjustmentReasonDetail"]</label>
                    <textarea asp-for="ReasonDetail" class="form-control" rows="2" placeholder="@L["Inventory:AdjustmentReasonDetailPlaceholder"]"></textarea>
                    <span asp-validation-for="ReasonDetail" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4">@L["Inventory:CountAdjustmentLines"]</h5>
            <div class="vpl-line-editor table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0 vpl-line-editor-table inventory-adjustment-count-lines-table">
                    <thead class="table-light">
                        <tr>
                            <th class="vpl-line-editor-col-main">@L["Inventory:Material"]</th>
                            <th class="vpl-line-editor-col-number">@L["Inventory:CurrentQuantity"]</th>
                            <th class="vpl-line-editor-col-number">@L["Inventory:CountedQuantity"]</th>
                            <th class="vpl-line-editor-col-number">@L["Inventory:Delta"]</th>
                            <th class="vpl-line-editor-col-text">@L["Inventory:Direction"]</th>
                            <th class="vpl-line-editor-col-text">@L["Inventory:LotNo"]</th>
                            <th class="vpl-line-editor-col-date">@L["Inventory:ReceivedAt"]</th>
                            <th class="vpl-line-editor-col-number">@L["Inventory:UnitCost"]</th>
                            <th class="vpl-line-editor-col-action text-end">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="adjustment-count-lines" data-inventory-line-container data-add-button="#add-adjustment-count-line" data-row-template="adjustment-count-line-row-template">
                    @for (var i = 0; i < Model.CountLines.Count; i++)
                    {
                        <tr data-inventory-line-row data-line-editor-row data-count-adjustment-row>
                            <td class="vpl-line-editor-col-main">
                                <label class="visually-hidden" for="CountLines_@i.ToString()__StockItemId"
                                       data-for="CountLines___index____StockItemId">@L["Inventory:Material"]</label>
                                <select class="vpl-select2-target stock-item-id js-select2"
                                        name="CountLines[@i].StockItemId"
                                        id="CountLines_@i.ToString()__StockItemId"
                                        data-use-select2="true"
                                        data-count-stock-item
                                        data-name="CountLines[__index__].StockItemId"
                                        data-id="CountLines___index____StockItemId">
                                    <option value="">@L["Select"]</option>
                                    @foreach (var option in Model.StockItemOptions)
                                    {
                                        if (InventoryPostingUi.IsOptionSelected(option.Value!, Model.CountLines[i].StockItemId))
                                        {
                                            <option value="@option.Value" selected="selected">@option.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    }
                                </select>
                                <span class="text-danger small" data-valmsg-for="CountLines[@i].StockItemId"
                                      data-valmsg-for-template="CountLines[__index__].StockItemId" data-valmsg-replace="true"></span>
                            </td>
                            <td class="vpl-line-editor-col-number">
                                <label class="visually-hidden" for="CountLines_@i.ToString()__CurrentQuantity"
                                       data-for="CountLines___index____CurrentQuantity">@L["Inventory:CurrentQuantity"]</label>
                                <input class="form-control form-control-sm" name="CountLines[@i].CurrentQuantity" id="CountLines_@i.ToString()__CurrentQuantity"
                                       value="@FormatQuantity(Model.CountLines[i].CurrentQuantity)" readonly data-current-quantity
                                       data-name="CountLines[__index__].CurrentQuantity" data-id="CountLines___index____CurrentQuantity" />
                            </td>
                            <td class="vpl-line-editor-col-number">
                                <label class="visually-hidden" for="CountLines_@i.ToString()__CountedQuantity"
                                       data-for="CountLines___index____CountedQuantity">@L["Inventory:CountedQuantity"]</label>
                                <input class="form-control form-control-sm" name="CountLines[@i].CountedQuantity" id="CountLines_@i.ToString()__CountedQuantity"
                                       value="@FormatNullableQuantity(Model.CountLines[i].CountedQuantity)" data-counted-quantity
                                       data-name="CountLines[__index__].CountedQuantity" data-id="CountLines___index____CountedQuantity" />
                                <span class="text-danger small" data-valmsg-for="CountLines[@i].CountedQuantity"
                                      data-valmsg-for-template="CountLines[__index__].CountedQuantity" data-valmsg-replace="true"></span>
                            </td>
                            <td class="vpl-line-editor-col-number">
                                <label class="visually-hidden" for="CountLines_@i.ToString()__Delta"
                                       data-for="CountLines___index____Delta">@L["Inventory:Delta"]</label>
                                <input class="form-control form-control-sm" name="CountLines[@i].Delta" id="CountLines_@i.ToString()__Delta"
                                       value="@FormatQuantity(Model.CountLines[i].Delta)" readonly data-delta
                                       data-name="CountLines[__index__].Delta" data-id="CountLines___index____Delta" />
                            </td>
                            <td class="vpl-line-editor-col-text">
                                <span class="badge text-bg-secondary" data-direction-label>@L["Inventory:NoChange"]</span>
                            </td>
                            <td class="vpl-line-editor-col-text" data-positive-delta-field>
                                <span class="form-control-plaintext form-control-sm text-muted py-0 mb-0">@L["Inventory:LotNoAutoGeneratedOnSave"]</span>
                            </td>
                            <td class="vpl-line-editor-col-date" data-positive-delta-field>
                                <label class="visually-hidden" for="CountLines_@i.ToString()__ReceivedAtText"
                                       data-for="CountLines___index____ReceivedAtText">@L["Inventory:ReceivedAt"]</label>
                                <input class="form-control form-control-sm" name="CountLines[@i].ReceivedAtText" id="CountLines_@i.ToString()__ReceivedAtText"
                                       value="@Model.CountLines[i].ReceivedAtText" inputmode="numeric" placeholder="dd/MM/yyyy"
                                       data-default-value="@Model.DefaultDateText"
                                       data-name="CountLines[__index__].ReceivedAtText" data-id="CountLines___index____ReceivedAtText" />
                                <span class="text-danger small" data-valmsg-for="CountLines[@i].ReceivedAtText"
                                      data-valmsg-for-template="CountLines[__index__].ReceivedAtText" data-valmsg-replace="true"></span>
                            </td>
                            <td class="vpl-line-editor-col-number" data-positive-delta-field>
                                <label class="visually-hidden" for="CountLines_@i.ToString()__UnitCost"
                                       data-for="CountLines___index____UnitCost">@L["Inventory:UnitCost"]</label>
                                <input class="form-control form-control-sm" name="CountLines[@i].UnitCost" id="CountLines_@i.ToString()__UnitCost"
                                       value="@FormatNullableQuantity(Model.CountLines[i].UnitCost)" data-name="CountLines[__index__].UnitCost"
                                       data-id="CountLines___index____UnitCost" />
                                <span class="text-danger small" data-valmsg-for="CountLines[@i].UnitCost"
                                      data-valmsg-for-template="CountLines[__index__].UnitCost" data-valmsg-replace="true"></span>
                            </td>
                            <td class="vpl-line-editor-col-action text-end">
                                <button class="btn btn-outline-danger btn-sm vpl-line-editor-icon-button"
                                        type="button"
                                        data-remove-line
                                        title="@L["Inventory:RemoveLine"]"
                                        aria-label="@L["Inventory:RemoveLine"]">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <button class="btn btn-outline-secondary btn-sm mt-3 vpl-line-editor-action" type="button" id="add-adjustment-count-line"><i class="fa fa-plus"></i> @L["Inventory:AddLine"]</button>
            <button class="btn btn-primary btn-sm mt-3" type="submit">@L["Inventory:Post"]</button>
        </form>
    </abp-card-body>
</abp-card>

<template id="adjustment-count-line-row-template">
    <tr data-inventory-line-row data-line-editor-row data-count-adjustment-row>
        <td class="vpl-line-editor-col-main">
            <label class="visually-hidden" data-for="CountLines___index____StockItemId">@L["Inventory:Material"]</label>
            <select class="vpl-select2-target stock-item-id js-select2"
                    data-use-select2="true"
                    data-count-stock-item
                    data-name="CountLines[__index__].StockItemId"
                    data-id="CountLines___index____StockItemId">
                <option value="">@L["Select"]</option>
                @foreach (var option in Model.StockItemOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <span class="text-danger small" data-valmsg-for-template="CountLines[__index__].StockItemId" data-valmsg-replace="true"></span>
        </td>
        <td class="vpl-line-editor-col-number">
            <label class="visually-hidden" data-for="CountLines___index____CurrentQuantity">@L["Inventory:CurrentQuantity"]</label>
            <input class="form-control form-control-sm" value="" readonly data-current-quantity
                   data-name="CountLines[__index__].CurrentQuantity" data-id="CountLines___index____CurrentQuantity" />
        </td>
        <td class="vpl-line-editor-col-number">
            <label class="visually-hidden" data-for="CountLines___index____CountedQuantity">@L["Inventory:CountedQuantity"]</label>
            <input class="form-control form-control-sm" value="" data-counted-quantity
                   data-name="CountLines[__index__].CountedQuantity" data-id="CountLines___index____CountedQuantity" />
            <span class="text-danger small" data-valmsg-for-template="CountLines[__index__].CountedQuantity" data-valmsg-replace="true"></span>
        </td>
        <td class="vpl-line-editor-col-number">
            <label class="visually-hidden" data-for="CountLines___index____Delta">@L["Inventory:Delta"]</label>
            <input class="form-control form-control-sm" value="" readonly data-delta
                   data-name="CountLines[__index__].Delta" data-id="CountLines___index____Delta" />
        </td>
        <td class="vpl-line-editor-col-text">
            <span class="badge text-bg-secondary" data-direction-label>@L["Inventory:NoChange"]</span>
        </td>
        <td class="vpl-line-editor-col-text" data-positive-delta-field>
            <span class="form-control-plaintext form-control-sm text-muted py-0 mb-0">@L["Inventory:LotNoAutoGeneratedOnSave"]</span>
        </td>
        <td class="vpl-line-editor-col-date" data-positive-delta-field>
            <label class="visually-hidden" data-for="CountLines___index____ReceivedAtText">@L["Inventory:ReceivedAt"]</label>
            <input class="form-control form-control-sm" inputmode="numeric" placeholder="dd/MM/yyyy"
                   data-default-value="@Model.DefaultDateText"
                   data-name="CountLines[__index__].ReceivedAtText" data-id="CountLines___index____ReceivedAtText" />
            <span class="text-danger small" data-valmsg-for-template="CountLines[__index__].ReceivedAtText" data-valmsg-replace="true"></span>
        </td>
        <td class="vpl-line-editor-col-number" data-positive-delta-field>
            <label class="visually-hidden" data-for="CountLines___index____UnitCost">@L["Inventory:UnitCost"]</label>
            <input class="form-control form-control-sm" value="" data-name="CountLines[__index__].UnitCost" data-id="CountLines___index____UnitCost" />
            <span class="text-danger small" data-valmsg-for-template="CountLines[__index__].UnitCost" data-valmsg-replace="true"></span>
        </td>
        <td class="vpl-line-editor-col-action text-end">
            <button class="btn btn-outline-danger btn-sm vpl-line-editor-icon-button"
                    type="button"
                    data-remove-line
                    title="@L["Inventory:RemoveLine"]"
                    aria-label="@L["Inventory:RemoveLine"]">
                <i class="fa fa-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section styles {
    <abp-style src="/Pages/Shared/LineEditors.css" />
}

@section scripts {
    <abp-script src="/Pages/Shared/DynamicRowSelects.js" />
    <abp-script src="/Pages/Inventory/Posting.js" />
}
