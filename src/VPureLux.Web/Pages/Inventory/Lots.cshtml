@page
@model VPureLux.Web.Pages.Inventory.LotsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L

@section scripts {
    <abp-script src="/Pages/Shared/DynamicRowSelects.js" />
    <abp-script src="/Pages/Inventory/InventoryFilterSelects.js" />
    <abp-script src="/Pages/Inventory/Lots.js" />
}

<div class="vpl-page vpl-inquiry-page"
     data-inventory-lots-page
     data-can-update-supplier="@Model.CanUpdateSupplier.ToString().ToLowerInvariant()"
     data-can-update-lot-info="@Model.CanUpdateLotInfo.ToString().ToLowerInvariant()">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Inventory:ReceiptLotHistory"]</h2>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-header>
            <h5 class="mb-0">@L["Search"]</h5>
        </abp-card-header>
        <abp-card-body>
            <form method="get" id="InventoryLotsSearchForm" class="row g-2 mb-0">
                <div class="col-md-3">
                    <label asp-for="WarehouseId" class="form-label">@L["Inventory:Warehouse"]</label>
                    <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" id="InventoryLotsWarehouseId" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="StockItemId" class="form-label">@L["Inventory:StockItem"]</label>
                    <select asp-for="StockItemId" asp-items="Model.StockItemOptions" id="InventoryLotsStockItemId"
                            class="vpl-select2-target inventory-filter-stock-item js-select2"
                            data-use-select2="true">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="LotNo" class="form-label">@L["Inventory:LotNo"]</label>
                    <input asp-for="LotNo" id="InventoryLotsLotNo" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">@L["Inventory:ApplyFilter"]</button>
                    <a class="btn btn-outline-secondary" asp-page="/Inventory/Lots">@L["Inventory:ClearFilter"]</a>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense">
        <abp-card-body>
            <div class="vpl-empty-state d-none" data-inventory-empty-state>@L["Inventory:NoLots"]</div>
            <abp-table id="InventoryLotsTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                    <tr>
                        <th>@L["Inventory:LotNo"]</th>
                        <th>@L["Inventory:Warehouse"]</th>
                        <th>@L["Inventory:Supplier"]</th>
                        <th>@L["Inventory:StockItem"]</th>
                        <th>@L["Inventory:ReceivedAt"]</th>
                        <th>@L["Inventory:ReceivedQuantity"]</th>
                        <th>@L["Inventory:Available"]</th>
                        <th>@L["Inventory:UnitCost"]</th>
                        <th>@L["Inventory:ReceiptValue"]</th>
                        @if (Model.CanUpdateLotInfo)
                        {
                            <th class="text-end">@L["Actions"]</th>
                        }
                    </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>

    @if (Model.CanUpdateLotInfo)
    {
        <div class="modal fade" id="InventoryLotSupplierModal" tabindex="-1" aria-labelledby="InventoryLotSupplierModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="InventoryLotSupplierForm">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="InventoryLotSupplierModalLabel">@L["Inventory:UpdateLotSupplier"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="InventoryLotSupplierLotId" />
                            <div class="mb-3">
                                <label class="form-label">@L["Inventory:LotNo"]</label>
                                <div class="form-control bg-light" id="InventoryLotSupplierLotLabel"></div>
                            </div>
                            <div class="mb-3">
                                <label for="InventoryLotSupplierId" class="form-label">@L["Inventory:Supplier"]</label>
                                <select id="InventoryLotSupplierId" class="form-select" required>
                                    <option value="">@L["Inventory:NoSupplierSelected"]</option>
                                    @foreach (var option in Model.SupplierOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@L["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="InventoryLotUnitCostModal" tabindex="-1" aria-labelledby="InventoryLotUnitCostModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="InventoryLotUnitCostForm">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="InventoryLotUnitCostModalLabel">@L["Inventory:UpdateLotUnitCost"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="InventoryLotUnitCostLotId" />
                            <div class="mb-3">
                                <label class="form-label">@L["Inventory:LotNo"]</label>
                                <div class="form-control bg-light" id="InventoryLotUnitCostLotLabel"></div>
                            </div>
                            <div class="mb-3">
                                <label for="InventoryLotUnitCost" class="form-label">@L["Inventory:UnitCostVnd"]</label>
                                <input id="InventoryLotUnitCost" class="form-control" inputmode="numeric" autocomplete="off" required data-vnd-money />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@L["Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
