@page
@model VPureLux.Web.Pages.Reports.SalesProfitModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using System.Globalization
@using VPureLux.Reports
@{
    ViewData["Title"] = L["Reports:SalesProfitTitle"];
}

@functions {
    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatMoney(decimal value)
    {
        var amount = decimal.Round(value, 0, MidpointRounding.AwayFromZero);
        return amount.ToString("#,0", Vi) + " ₫";
    }

    private static string FormatSignedMoney(decimal value)
    {
        return value < 0 ? "-" + FormatMoney(Math.Abs(value)) : FormatMoney(value);
    }

    private static string FormatQuantity(decimal value)
    {
        if (value == decimal.Truncate(value))
        {
            return decimal.Truncate(value).ToString("0", Vi);
        }

        return value.ToString("0.####", Vi);
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToString("dd/MM/yyyy", Vi);
    }

    private static string FormatPercent(decimal value)
    {
        return value.ToString("0.##", Vi) + "%";
    }

    private static string ProfitClass(decimal value)
    {
        return value < 0 ? "text-danger fw-semibold" : value > 0 ? "text-success fw-semibold" : string.Empty;
    }
}

<div class="vpl-page vpl-inquiry-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Reports:SalesProfitTitle"]</h2>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-header>
            <h5 class="mb-0">@L["Search"]</h5>
        </abp-card-header>
        <abp-card-body>
            <form method="get" class="row g-2 align-items-end mb-0">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="col-md-2">
                    <label asp-for="FromDate" class="form-label">@L["Reports:FromDate"]</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="ToDate" class="form-label">@L["Reports:ToDate"]</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="GroupBy" class="form-label">@L["Reports:GroupBy"]</label>
                    <select asp-for="GroupBy" class="form-select">
                        @foreach (var group in Model.GroupByOptions)
                        {
                            <option value="@group">@L[$"Reports:GroupBy:{group}"]</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="ProductId" class="form-label">@L["Reports:Product"]</label>
                    <select asp-for="ProductId" asp-items="Model.ProductOptions" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="CustomerId" class="form-label">@L["Reports:Customer"]</label>
                    <select asp-for="CustomerId" asp-items="Model.CustomerOptions" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="WarehouseId" class="form-label">@L["Reports:Warehouse"]</label>
                    <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input asp-for="LossOnly" class="form-check-input" />
                        <label asp-for="LossOnly" class="form-check-label">@L["Reports:LossOnly"]</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input asp-for="MissingCostOnly" class="form-check-input" />
                        <label asp-for="MissingCostOnly" class="form-check-label">@L["Reports:MissingCostOnly"]</label>
                    </div>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Reports:Filter"]</button>
                    <a class="btn btn-outline-secondary" asp-page="/Reports/SalesProfit">@L["Reports:Reset"]</a>
                    @if (Model.CanExport)
                    {
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="Export">@L["Reports:ExportCsv"]</button>
                    }
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    @if (!Model.HasData)
    {
        <abp-card class="vpl-inquiry-results-card vpl-card-dense">
            <abp-card-body>
                <div class="vpl-empty-state">@L["Reports:NoSalesProfitData"]</div>
            </abp-card-body>
        </abp-card>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:Revenue"]</div>
                        <div class="fs-5 fw-semibold">@FormatMoney(Model.Report.Summary.Revenue)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:CostAmount"]</div>
                        <div class="fs-5 fw-semibold">@FormatMoney(Model.Report.Summary.CostAmount)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:ProfitAmount"]</div>
                        <div class="fs-5 @ProfitClass(Model.Report.Summary.ProfitAmount)">@FormatSignedMoney(Model.Report.Summary.ProfitAmount)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:ProfitMargin"]</div>
                        <div class="fs-5 fw-semibold">@FormatPercent(Model.Report.Summary.ProfitMarginPercent)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:ConfirmedOrderCount"]</div>
                        <div class="fs-5 fw-semibold">@Model.Report.Summary.ConfirmedOrderCount.ToString("#,0", Vi)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">@L["Reports:MissingCostLineCount"]</div>
                        <div class="fs-5 fw-semibold">@Model.Report.Summary.MissingCostLineCount.ToString("#,0", Vi)</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Report.Summary.MissingCostLineCount > 0)
        {
            <div class="alert alert-warning">@L["Reports:MissingCostWarning"]</div>
        }

        <abp-card class="vpl-inquiry-results-card vpl-card-dense mb-3">
            <abp-card-header>
                <h5 class="mb-0">@L["Reports:ProfitByPeriod"]</h5>
            </abp-card-header>
            <abp-card-body>
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                        <tr>
                            <th>@L["Reports:Period"]</th>
                            <th class="text-end">@L["Reports:OrderCount"]</th>
                            <th class="text-end">@L["Reports:Revenue"]</th>
                            <th class="text-end">@L["Reports:CostAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitMarginShort"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Report.ByPeriod)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.PeriodLabel) ? row.PeriodKey : row.PeriodLabel)</td>
                            <td class="text-end">@row.OrderCount.ToString("#,0", Vi)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.Revenue)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.CostAmount)</td>
                            <td class="text-end text-nowrap @ProfitClass(row.ProfitAmount)">@FormatSignedMoney(row.ProfitAmount)</td>
                            <td class="text-end text-nowrap">@FormatPercent(row.ProfitMarginPercent)</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>

        <abp-card class="vpl-inquiry-results-card vpl-card-dense mb-3">
            <abp-card-header>
                <h5 class="mb-0">@L["Reports:ProfitByProduct"]</h5>
            </abp-card-header>
            <abp-card-body>
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                        <tr>
                            <th>@L["Reports:ProductCode"]</th>
                            <th>@L["Reports:ProductName"]</th>
                            <th class="text-end">@L["Reports:SoldQuantityShort"]</th>
                            <th class="text-end">@L["Reports:Revenue"]</th>
                            <th class="text-end">@L["Reports:CostAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitMarginShort"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Report.ByProduct)
                    {
                        <tr>
                            <td class="text-nowrap">@row.ProductCode</td>
                            <td>@row.ProductName</td>
                            <td class="text-end">@FormatQuantity(row.Quantity)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.Revenue)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.CostAmount)</td>
                            <td class="text-end text-nowrap @ProfitClass(row.ProfitAmount)">@FormatSignedMoney(row.ProfitAmount)</td>
                            <td class="text-end text-nowrap">@FormatPercent(row.ProfitMarginPercent)</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>

        <abp-card class="vpl-inquiry-results-card vpl-card-dense mb-3">
            <abp-card-header>
                <h5 class="mb-0">@L["Reports:ProfitByCustomer"]</h5>
            </abp-card-header>
            <abp-card-body>
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                        <tr>
                            <th>@L["Reports:CustomerCode"]</th>
                            <th>@L["Reports:CustomerName"]</th>
                            <th class="text-end">@L["Reports:OrderCount"]</th>
                            <th class="text-end">@L["Reports:Revenue"]</th>
                            <th class="text-end">@L["Reports:CostAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitMarginShort"]</th>
                            <th class="text-end">@L["Reports:RemainingAmount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Report.ByCustomer)
                    {
                        <tr>
                            <td class="text-nowrap">@row.CustomerCode</td>
                            <td>@row.CustomerName</td>
                            <td class="text-end">@row.OrderCount.ToString("#,0", Vi)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.Revenue)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.CostAmount)</td>
                            <td class="text-end text-nowrap @ProfitClass(row.ProfitAmount)">@FormatSignedMoney(row.ProfitAmount)</td>
                            <td class="text-end text-nowrap">@FormatPercent(row.ProfitMarginPercent)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.RemainingAmount)</td>
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>

        <abp-card class="vpl-inquiry-results-card vpl-card-dense">
            <abp-card-header>
                <h5 class="mb-0">@L["Reports:SalesLineDetail"]</h5>
            </abp-card-header>
            <abp-card-body>
                <abp-table striped-rows="true" class="vpl-table-dense">
                    <thead>
                        <tr>
                            <th>@L["Reports:OrderNo"]</th>
                            <th>@L["Reports:ConfirmationTime"]</th>
                            <th>@L["Reports:CustomerName"]</th>
                            <th>@L["Reports:ProductCode"]</th>
                            <th>@L["Reports:Product"]</th>
                            <th class="text-end">@L["Reports:Quantity"]</th>
                            <th class="text-end">@L["Reports:UnitPrice"]</th>
                            <th class="text-end">@L["Reports:Revenue"]</th>
                            <th class="text-end">@L["Reports:CostAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitAmount"]</th>
                            <th class="text-end">@L["Reports:ProfitMarginShort"]</th>
                            <th>@L["Reports:Note"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Report.Lines)
                    {
                        <tr>
                            <td><a asp-page="/Sales/Details" asp-route-id="@row.SalesOrderId">@row.OrderNo</a></td>
                            <td>@FormatDate(row.ConfirmationTime)</td>
                            <td>@row.CustomerName</td>
                            <td class="text-nowrap">@row.ProductCode</td>
                            <td>@row.ProductName</td>
                            <td class="text-end">@FormatQuantity(row.Quantity)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.UnitPrice)</td>
                            <td class="text-end text-nowrap">@FormatMoney(row.Revenue)</td>
                            @if (row.MissingCost)
                            {
                                <td class="text-end text-nowrap text-warning">@L["Reports:MissingCost"]</td>
                                <td class="text-end">—</td>
                                <td class="text-end">—</td>
                                <td><span class="badge text-bg-warning text-dark">@L["Reports:MissingCostNote"]</span></td>
                            }
                            else
                            {
                                <td class="text-end text-nowrap">@FormatMoney(row.CostAmount)</td>
                                <td class="text-end text-nowrap @ProfitClass(row.ProfitAmount)">@FormatSignedMoney(row.ProfitAmount)</td>
                                <td class="text-end text-nowrap">@FormatPercent(row.ProfitMarginPercent)</td>
                                <td></td>
                            }
                        </tr>
                    }
                    </tbody>
                </abp-table>
            </abp-card-body>
        </abp-card>
    }
</div>
