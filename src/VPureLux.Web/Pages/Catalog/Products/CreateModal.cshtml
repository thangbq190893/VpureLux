@page
@model VPureLux.Web.Pages.Catalog.Products.CreateModalModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}

<form method="post" asp-page="/Catalog/Products/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["Catalog:NewProduct"]"></abp-modal-header>
        <abp-modal-body>
            <label asp-for="Input.Code" class="form-label">@L["Catalog:ProductCode"] <span class="text-danger">*</span></label>
            <input asp-for="Input.Code" class="form-control mb-1" />
            <span asp-validation-for="Input.Code" class="text-danger d-block mb-3"></span>
            <abp-input asp-for="Input.Name" />
            <abp-input asp-for="Input.Description" />
            <p class="text-muted mb-0">@L["Catalog:ImageManagedOnFullPage"]</p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
