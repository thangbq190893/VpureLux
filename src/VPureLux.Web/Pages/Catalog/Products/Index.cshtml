@page
@model VPureLux.Web.Pages.Catalog.Products.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Catalog:Products"];
    var canEdit = Model.CanEdit.ToString().ToLowerInvariant();
    var canViewPricingContext = Model.CanViewPricingContext.ToString().ToLowerInvariant();
}

@section scripts {
    <abp-script src="/Pages/Catalog/CatalogIndex.js" />
    <abp-script src="/Pages/Catalog/Products/Index.js" />
}

<div data-catalog-index
     data-create-view-url="Catalog/Products/CreateModal"
     data-edit-view-url="Catalog/Products/EditModal"
     data-details-view-url="Catalog/Products/DetailsModal"
     data-table-selector="#ProductsTable"
     data-can-edit="@canEdit"
     data-can-view-pricing-context="@canViewPricingContext"
     data-saved-message="@L["Catalog:ProductSavedSuccessfully"]"
     data-activated-message="@L["Catalog:ProductActivatedSuccessfully"]"
     data-deactivated-message="@L["Catalog:ProductDeactivatedSuccessfully"]"
     data-status-success="@(string.IsNullOrWhiteSpace(Model.StatusMessageKey) ? string.Empty : L[Model.StatusMessageKey].Value)"></div>

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Catalog:Products"]</h2>
        <div class="vpl-btn-toolbar">
            @if (Model.CanCreate)
            {
                <a asp-page="/Catalog/Products/Create" class="btn btn-primary" data-catalog-create><i class="fa fa-plus"></i> @L["Catalog:NewProduct"]</a>
            }
        </div>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <form id="ProductsSearchForm" class="mb-3">
                <abp-row>
                    <abp-column size-md="_4">
                        <input asp-for="Keyword" id="ProductsKeyword" class="form-control" placeholder="@L["Search"]" />
                    </abp-column>
                    <abp-column size-md="_4">
                        <abp-button button-type="Secondary" type="submit">@L["Search"]</abp-button>
                        <abp-button button-type="Light" type="button" id="ProductsClearButton">@L["Clear"]</abp-button>
                    </abp-column>
                </abp-row>
            </form>
            <abp-table id="ProductsTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                <tr>
                    <th class="text-start">@L["Actions"]</th>
                    <th>@L["Catalog:Image"]</th>
                    <th>@L["Catalog:Code"]</th>
                    <th>@L["Catalog:Name"]</th>
                    <th>@L["Catalog:Status"]</th>
                    @if (Model.CanViewPricingContext)
                    {
                        <th class="text-end">@L["Catalog:CurrentProductSuggestedPrice"]</th>
                        <th>@L["Catalog:BomStatus"]</th>
                    }
                </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
