@page "{id:guid?}"
@model VPureLux.Web.Pages.Catalog.Products.EditModalModel
@using VPureLux.Permissions
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
    var canManageMachineSettings = (await AuthorizationService.AuthorizeAsync(
        User, null, VPureLuxPermissions.Warranty.ManageMachines)).Succeeded;
    if (canManageMachineSettings)
    {
        Model.Input.MachineSetting ??= new VPureLux.Catalog.Products.ProductMachineSettingInputDto();
    }
}

<form method="post" asp-page="/Catalog/Products/EditModal">
    <input type="hidden" asp-for="Id" />
    <abp-modal>
        <abp-modal-header title="@L["Edit"]"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Input.Code" />
            <abp-input asp-for="Input.Name" />
            <abp-input asp-for="Input.Description" />
            @if (canManageMachineSettings)
            {
                <div class="border-top pt-3 mt-3">
                    <abp-input asp-for="Input.MachineSetting!.IsMachine" />
                </div>
            }
            <p class="text-muted mb-0">@L["Catalog:ImageManagedOnFullPage"]</p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
