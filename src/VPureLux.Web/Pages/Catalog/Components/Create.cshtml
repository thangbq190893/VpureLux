@page
@model VPureLux.Web.Pages.Catalog.Components.CreateModel
@using VPureLux.Permissions
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = L["Catalog:NewComponent"];
    var canManageReplacementPolicies = (await AuthorizationService.AuthorizeAsync(
        User, null, VPureLuxPermissions.Warranty.ManagePolicies)).Succeeded;
    if (canManageReplacementPolicies)
    {
        Model.Input.ReplacementPolicy ??= new VPureLux.Catalog.Components.ComponentReplacementPolicyInputDto();
    }
}

<abp-card>
    <abp-card-header>
        <h2>@L["Catalog:NewComponent"]</h2>
    </abp-card-header>
    <abp-card-body>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">@L["Catalog:Code"]</label>
                <div class="form-control-plaintext text-muted">@L["Catalog:CodeAutoGeneratedOnSave"]</div>
            </div>
            <abp-input asp-for="Input.Name" />
            <abp-input asp-for="Input.Description" />
            <abp-input asp-for="Input.Unit" />
            @if (canManageReplacementPolicies)
            {
                <div class="border-top pt-3 mt-3" data-replacement-policy-editor>
                    <abp-input asp-for="Input.ReplacementPolicy!.IsEnabled" />
                    <div data-replacement-policy-fields
                         class="@(Model.Input.ReplacementPolicy!.IsEnabled ? string.Empty : "d-none")">
                        <abp-row>
                            <abp-column size-md="_6">
                                <abp-input asp-for="Input.ReplacementPolicy.CycleMonths" />
                            </abp-column>
                            <abp-column size-md="_6">
                                <abp-input asp-for="Input.ReplacementPolicy.WarningDaysBeforeDue" />
                            </abp-column>
                        </abp-row>
                        <abp-input asp-for="Input.ReplacementPolicy.Note" />
                    </div>
                </div>
            }
            <label class="form-label" for="Image">@L["Catalog:UploadImage"]</label>
            <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"
                   data-catalog-image-input data-preview-target="#image-preview" />
            <div class="form-text">@L["Catalog:SupportedImageFormats"]</div>
            <img id="image-preview" class="d-none mt-3 border rounded" width="96" height="96"
                 style="object-fit:contain" alt="@L["Catalog:ImagePreview"]" />
            <div class="mt-3">
                <abp-button button-type="Primary" type="submit">@L["Save"]</abp-button>
                <a class="btn btn-secondary" asp-page="/Catalog/Components/Index">@L["Cancel"]</a>
            </div>
        </form>
    </abp-card-body>
</abp-card>

@section scripts {
    <abp-script src="/Pages/Catalog/catalog-image-preview.js" />
    <abp-script src="/Pages/Catalog/replacement-policy-fields.js" />
}
