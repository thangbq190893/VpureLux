@page
@model VPureLux.Web.Pages.OperatingCosts.CreateModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["OperatingCosts:CreateEntry"];
}

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["OperatingCosts:CreateEntry"]</h2>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <form method="post">
                <partial name="_EntryForm" model="Model.Form" />
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a class="btn btn-outline-secondary" asp-page="/OperatingCosts/Index">@L["Back"]</a>
            </form>
        </abp-card-body>
    </abp-card>
</div>
