@page
@model VPureLux.Web.Pages.OperatingCosts.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using VPureLux.OperatingCosts
@{
    ViewData["Title"] = L["OperatingCosts:Title"];
}

@section scripts {
    <abp-script src="/Pages/OperatingCosts/Index.js" />
}

@section styles {
    <abp-style src="/Pages/OperatingCosts/Index.css" />
}

<div data-operating-costs-index
     data-can-manage-entries="@Model.CanManageEntries.ToString().ToLowerInvariant()"
     data-can-manage-categories="@Model.CanManageCategories.ToString().ToLowerInvariant()"
     data-can-delete="@Model.CanDelete.ToString().ToLowerInvariant()"
     data-status-success="@(string.IsNullOrWhiteSpace(Model.StatusMessageKey) ? string.Empty : L[Model.StatusMessageKey].Value)"></div>

<div class="vpl-page vpl-inquiry-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["OperatingCosts:Title"]</h2>
        <div class="vpl-btn-toolbar">
            @if (Model.CanManageCategories)
            {
                <a class="btn btn-outline-secondary" asp-page="/OperatingCosts/Categories">@L["OperatingCosts:Categories"]</a>
            }
            @if (Model.CanManageEntries)
            {
                <a class="btn btn-primary" asp-page="/OperatingCosts/Create">@L["OperatingCosts:CreateEntry"]</a>
            }
        </div>
    </div>

    <div class="operating-costs-summary mb-3">
        <div class="operating-costs-metric operating-costs-metric-income">
            <span class="operating-costs-metric-label">@L["OperatingCosts:TotalIncome"]</span>
            <strong id="OperatingCostsTotalIncome">0 ₫</strong>
        </div>
        <div class="operating-costs-metric operating-costs-metric-expense">
            <span class="operating-costs-metric-label">@L["OperatingCosts:TotalExpense"]</span>
            <strong id="OperatingCostsTotalExpense">0 ₫</strong>
        </div>
        <div class="operating-costs-metric">
            <span class="operating-costs-metric-label">@L["OperatingCosts:NetAmount"]</span>
            <strong id="OperatingCostsNetAmount">0 ₫</strong>
        </div>
        <div class="operating-costs-metric operating-costs-debt-metric">
            <span class="operating-costs-metric-label">@L["OperatingCosts:MonthDebt"]</span>
            <span class="operating-costs-debt-values">
                <span>@L["OperatingCosts:Receivable"]: <strong id="OperatingCostsUnpaidReceivable">0 ₫</strong></span>
                <span>@L["OperatingCosts:Payable"]: <strong id="OperatingCostsUnpaidPayable">0 ₫</strong></span>
            </span>
        </div>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense operating-costs-filter-card mb-3">
        <abp-card-body>
            <form id="OperatingCostsSearchForm" class="operating-costs-filter-grid mb-0">
                <div class="operating-costs-filter-item operating-costs-date-item">
                    <label asp-for="FromDate" class="form-label">@L["OperatingCosts:FromDate"]</label>
                    <input name="FromDate"
                           id="OperatingCostsFromDate"
                           type="date"
                           class="form-control form-control-sm"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
                <div class="operating-costs-filter-item operating-costs-date-item">
                    <label asp-for="ToDate" class="form-label">@L["OperatingCosts:ToDate"]</label>
                    <input name="ToDate"
                           id="OperatingCostsToDate"
                           type="date"
                           class="form-control form-control-sm"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
                <div class="operating-costs-filter-item">
                    <label asp-for="Direction" class="form-label">@L["OperatingCosts:Direction"]</label>
                    <select asp-for="Direction" id="OperatingCostsDirection" class="form-select form-select-sm">
                        <option value="">@L["Select"]</option>
                        <option value="@OperatingCostDirection.Expense">@L["OperatingCosts:Direction:Expense"]</option>
                        <option value="@OperatingCostDirection.Income">@L["OperatingCosts:Direction:Income"]</option>
                    </select>
                </div>
                <div class="operating-costs-filter-item">
                    <label asp-for="PaymentStatus" class="form-label">@L["OperatingCosts:PaymentStatus"]</label>
                    <select asp-for="PaymentStatus" id="OperatingCostsPaymentStatus" class="form-select form-select-sm">
                        <option value="">@L["Select"]</option>
                        <option value="@OperatingCostPaymentStatus.Paid">@L["OperatingCosts:PaymentStatus:Paid"]</option>
                        <option value="@OperatingCostPaymentStatus.Unpaid">@L["OperatingCosts:PaymentStatus:Unpaid"]</option>
                    </select>
                </div>
                <div class="operating-costs-filter-item operating-costs-category-item">
                    <label asp-for="CategoryId" class="form-label">@L["OperatingCosts:Category"]</label>
                    <select asp-for="CategoryId" id="OperatingCostsCategoryId" class="form-select form-select-sm">
                        <option value="">@L["Select"]</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Code - @category.Name</option>
                        }
                    </select>
                </div>
                <div class="operating-costs-filter-item operating-costs-search-item">
                    <label asp-for="SearchText" class="form-label">@L["Search"]</label>
                    <input asp-for="SearchText" id="OperatingCostsSearchText" class="form-control form-control-sm" placeholder="@L["OperatingCosts:SearchPlaceholder"]" />
                </div>
                <div class="operating-costs-filter-actions">
                    <button type="submit" class="btn btn-primary btn-sm">@L["Search"]</button>
                    <button type="button" id="OperatingCostsClearButton" class="btn btn-outline-secondary btn-sm">@L["Clear"]</button>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense operating-costs-table-card">
        <abp-card-body>
            <abp-table id="OperatingCostsTable" striped-rows="true" class="vpl-table-dense operating-costs-table">
                <thead>
                <tr>
                    <th class="operating-costs-actions-column">@L["Actions"]</th>
                    <th class="operating-costs-date-column">@L["OperatingCosts:EntryDate"]</th>
                    <th class="operating-costs-direction-column">@L["OperatingCosts:Direction"]</th>
                    <th class="operating-costs-category-column">@L["OperatingCosts:Category"]</th>
                    <th class="operating-costs-description-column">@L["OperatingCosts:Description"]</th>
                    <th class="operating-costs-amount-column text-end">@L["OperatingCosts:Amount"]</th>
                    <th class="operating-costs-payment-column">@L["OperatingCosts:PaymentStatus"]</th>
                    <th class="operating-costs-counterparty-column">@L["OperatingCosts:Counterparty"]</th>
                </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
