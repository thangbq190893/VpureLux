@page
@model VPureLux.Web.Pages.Audit.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Audit:Title"];
}

@section scripts {
    <abp-script src="/Pages/Audit/Index.js" />
}

<div class="vpl-page vpl-inquiry-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Audit:Title"]</h2>
        <div class="vpl-btn-toolbar">
            <a class="btn btn-outline-secondary" asp-page="/Audit/Reports">@L["Audit:Reports"]</a>
            @if (Model.CanExport)
            {
                <a class="btn btn-primary" asp-page="/Audit/Export">@L["Audit:Export"]</a>
            }
        </div>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-header>
            <h5 class="mb-0">@L["Search"]</h5>
        </abp-card-header>
        <abp-card-body>
            <form id="AuditSearchForm" class="row g-2 mb-0">
                <div class="col-md-2">
                    <input asp-for="Input.Module" id="AuditModule" class="form-control" placeholder="@L["Audit:Module"]" />
                </div>
                <div class="col-md-2">
                    <input asp-for="Input.EntityType" id="AuditEntityType" class="form-control" placeholder="@L["Audit:Entity"]" />
                </div>
                <div class="col-md-3">
                    <input asp-for="Input.CorrelationId" id="AuditCorrelationId" class="form-control" placeholder="@L["Audit:CorrelationId"]" />
                </div>
                <div class="col-md-2">
                    <select asp-for="Input.Severity" id="AuditSeverity" class="form-select">
                        <option value="">@L["Audit:AllSeverity"]</option>
                        <option value="Informational">@L["Audit:Severity:Informational"]</option>
                        <option value="Important">@L["Audit:Severity:Important"]</option>
                        <option value="Critical">@L["Audit:Severity:Critical"]</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-secondary" type="submit">@L["Search"]</button>
                    <button class="btn btn-light" type="button" id="AuditClearButton">@L["Clear"]</button>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense">
        <abp-card-body>
            <abp-table id="AuditTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                    <tr>
                        <th>@L["Audit:EventTime"]</th>
                        <th>@L["Audit:Module"]</th>
                        <th>@L["Audit:Action"]</th>
                        <th>@L["Audit:Entity"]</th>
                        <th>@L["Audit:Severity"]</th>
                        <th>@L["Audit:Status"]</th>
                        <th></th>
                    </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
