@page "/Pricing/Products/Create/{productId:guid}"
@model VPureLux.Web.Pages.Pricing.Products.CreateModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{ ViewData["Title"] = L["Pricing:CreateProductSuggestedPrice"]; }

<abp-card>
    <abp-card-header><h2>@L["Pricing:CreateProductSuggestedPrice"]</h2></abp-card-header>
    <abp-card-body>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <p class="text-muted">@L["Pricing:ProductContext", Model.ProductLabel]</p>
            <div class="border rounded p-3 mb-3">
                <div class="text-muted small">@L["Pricing:ComponentBuildPrice"]</div>
                @if (Model.ComponentBuildPrice.HasValue)
                {
                    <div class="fs-5 fw-semibold">@Model.ComponentBuildPriceText</div>
                    <div class="text-muted small">@L["Pricing:ComponentBuildPriceHint"]</div>
                }
                else if (!Model.HasPublishedBom)
                {
                    <div class="text-muted">@L["Pricing:NoPublishedBom"]</div>
                }
                else if (Model.HasMissingComponentSuggestedPrices)
                {
                    <div class="text-warning">@L["Pricing:MissingComponentPrices"]</div>
                }
                else
                {
                    <div class="text-muted">-</div>
                }
            </div>
            <div class="mb-3">
                <label asp-for="Input.Price" class="form-label">@L["Pricing:ProductListPrice"]</label>
                <input asp-for="Input.Price" class="form-control" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Reason" class="form-label">@L["Pricing:Reason"]</label>
                <input asp-for="Input.Reason" class="form-control" />
                <span asp-validation-for="Input.Reason" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EffectiveFromText" class="form-label">@L["Pricing:EffectiveFrom"]</label>
                <input asp-for="EffectiveFromText" class="form-control" inputmode="numeric" placeholder="dd/MM/yyyy" />
                <span asp-validation-for="EffectiveFromText" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">@L["Pricing:CreateNewVersion"]</button>
            <a class="btn btn-secondary" asp-page="/Pricing/Products/History" asp-route-productId="@Model.ProductId">@L["Cancel"]</a>
        </form>
    </abp-card-body>
</abp-card>
