@page
@model VPureLux.Web.Pages.Customers.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Customers:Title"];
    var canEdit = Model.CanEdit.ToString().ToLowerInvariant();
    var canManageStatus = Model.CanManageStatus.ToString().ToLowerInvariant();
}

@section scripts {
    <abp-script src="/Pages/Customers/Index.js" />
}

<div data-customers-index
     data-can-edit="@canEdit"
     data-can-manage-status="@canManageStatus"
     data-status-success="@(string.IsNullOrWhiteSpace(Model.StatusMessageKey) ? string.Empty : L[Model.StatusMessageKey].Value)"></div>

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Customers:Title"]</h2>
        <div class="vpl-btn-toolbar">
            @if (Model.CanCreate)
            {
                <a class="btn btn-primary" asp-page="/Customers/Create" data-customer-create>@L["Customers:Create"]</a>
            }
        </div>
    </div>

    <abp-card class="vpl-card-dense">
        <abp-card-body>
            <form id="CustomersSearchForm" class="mb-3">
                <abp-row>
                    <abp-column size-md="_4">
                        <input asp-for="SearchText" id="CustomersSearchText" class="form-control" placeholder="@L["Search"]" />
                    </abp-column>
                    <abp-column size-md="_3">
                        <select asp-for="Status" id="CustomersStatus" class="form-select">
                            <option value="">@L["Customers:Status"]</option>
                            @foreach (var status in Enum.GetValues<VPureLux.Customers.CustomerStatus>())
                            {
                                <option value="@status" selected="@(Model.Status == status)">@L[$"Status:{status}"]</option>
                            }
                        </select>
                    </abp-column>
                    <abp-column size-md="_3">
                        <button class="btn btn-secondary" type="submit">@L["Search"]</button>
                        <button class="btn btn-light" type="button" id="CustomersClearButton">@L["Clear"]</button>
                    </abp-column>
                </abp-row>
            </form>
            <abp-table id="CustomersTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                <tr>
                    <th class="text-start">@L["Actions"]</th>
                    <th>@L["Customers:Name"]</th>
                    <th>@L["Customers:PhoneNumber"]</th>
                    <th>@L["Customers:Address"]</th>
                    <th>@L["Customers:Status"]</th>
                </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
