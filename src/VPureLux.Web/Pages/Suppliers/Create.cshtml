@page
@model VPureLux.Web.Pages.Suppliers.CreateModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Suppliers:Create"];
}

<div class="vpl-page">
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Suppliers:Create"]</h2>
    </div>

    <abp-card class="vpl-entry-surface">
        <abp-card-body>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Code" class="form-label">@L["Suppliers:Code"]</label>
                    <input asp-for="Input.Code" class="form-control" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <partial name="_Form" for="Input" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">@L["Save"]</button>
                    <a asp-page="/Suppliers/Index" class="btn btn-light">@L["Cancel"]</a>
                </div>
            </form>
        </abp-card-body>
    </abp-card>
</div>
