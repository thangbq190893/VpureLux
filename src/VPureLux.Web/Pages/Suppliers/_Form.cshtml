@model VPureLux.Suppliers.UpdateSupplierDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L

<div class="mb-3">
    <label asp-for="Name" class="form-label">@L["Suppliers:Name"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ContactName" class="form-label">@L["Suppliers:ContactName"]</label>
    <input asp-for="ContactName" class="form-control" />
    <span asp-validation-for="ContactName" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Phone" class="form-label">@L["Suppliers:Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Email" class="form-label">@L["Suppliers:Email"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="TaxCode" class="form-label">@L["Suppliers:TaxCode"]</label>
    <input asp-for="TaxCode" class="form-control" />
    <span asp-validation-for="TaxCode" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Address" class="form-label">@L["Suppliers:Address"]</label>
    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Note" class="form-label">@L["Suppliers:Note"]</label>
    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Note" class="text-danger"></span>
</div>
