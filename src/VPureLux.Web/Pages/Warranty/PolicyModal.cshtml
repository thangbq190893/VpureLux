@page "{componentId:guid?}"
@model VPureLux.Web.Pages.Warranty.PolicyModalModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}

<form method="post" asp-page="/Warranty/PolicyModal">
    <input type="hidden" asp-for="ComponentId" />
    <input type="hidden" asp-for="ComponentCode" />
    <input type="hidden" asp-for="ComponentName" />
    <abp-modal>
        <abp-modal-header title="@L["Warranty:EditPolicy"]"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-3">
                <label class="form-label">@L["Warranty:Component"]</label>
                <input class="form-control" value="@Model.ComponentCode - @Model.ComponentName" disabled />
            </div>
            <abp-input asp-for="Input.IsEnabled" />
            <abp-input asp-for="Input.CycleMonths" />
            <abp-input asp-for="Input.WarningDaysBeforeDue" />
            <abp-input asp-for="Input.Note" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
