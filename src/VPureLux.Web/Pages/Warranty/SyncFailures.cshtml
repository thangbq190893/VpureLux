@page
@model VPureLux.Web.Pages.Warranty.SyncFailuresModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Warranty:SyncFailures"];
}

@section scripts {
    <abp-script src="/Pages/Warranty/SyncFailures.js" />
}

<div class="vpl-page vpl-inquiry-page" data-warranty-sync-failures>
    <div class="vpl-page-header">
        <h2 class="vpl-page-title mb-0">@L["Warranty:SyncFailures"]</h2>
    </div>

    <abp-card class="vpl-inquiry-filter-card vpl-card-dense mb-3">
        <abp-card-body>
            <form id="WarrantySyncFailureSearchForm" class="row g-2 mb-0">
                <div class="col-md-7">
                    <input id="WarrantySyncFailureSearchText" class="form-control" placeholder="@L["Warranty:SyncFailureSearchPlaceholder"]" />
                </div>
                <div class="col-md-2">
                    <select id="WarrantySyncFailureStatus" class="form-select">
                        <option value="">@L["All"]</option>
                        <option value="1">@L["Warranty:SyncStatus:Pending"]</option>
                        <option value="2">@L["Warranty:SyncStatus:Resolved"]</option>
                        <option value="3">@L["Warranty:SyncStatus:Ignored"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-secondary" type="submit">@L["Search"]</button>
                    <button class="btn btn-light" type="button" id="WarrantySyncFailureClearButton">@L["Clear"]</button>
                </div>
            </form>
        </abp-card-body>
    </abp-card>

    <form id="WarrantySyncFailureTokenForm" method="post"></form>

    <abp-card class="vpl-inquiry-results-card vpl-card-dense">
        <abp-card-body>
            <abp-table id="WarrantySyncFailuresTable" striped-rows="true" class="vpl-table-dense">
                <thead>
                    <tr>
                        <th></th>
                        <th>@L["Warranty:Status"]</th>
                        <th>@L["Warranty:Order"]</th>
                        <th>@L["Warranty:Product"]</th>
                        <th>@L["Warranty:SyncError"]</th>
                        <th>@L["Warranty:AttemptCount"]</th>
                        <th>@L["Warranty:LastOccurredAt"]</th>
                        <th>@L["Warranty:NextRetryAt"]</th>
                    </tr>
                </thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
