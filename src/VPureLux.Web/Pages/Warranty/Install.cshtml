@page "{id:guid}"
@model VPureLux.Web.Pages.Warranty.InstallModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@{
    ViewData["Title"] = L["Warranty:ConfirmInstallation"];
}

@section scripts {
    <abp-script src="/Pages/Warranty/Install.js" />
}

<div class="vpl-page" data-warranty-installation>
    <div class="vpl-page-header d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="vpl-page-title mb-1">@L["Warranty:ConfirmInstallation"]</h2>
            <div class="text-muted">@Model.Asset.AssetNo · @Model.Asset.CustomerCode - @Model.Asset.CustomerName</div>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Warranty/PendingInstallations">
            <i class="fa fa-arrow-left"></i> @L["Back"]
        </a>
    </div>

    <form method="post" id="WarrantyInstallationForm">
        <input asp-for="Id" type="hidden" />
        <input asp-for="Input.IdempotencyKey" type="hidden" />
        <abp-validation-summary />

        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <abp-card class="vpl-card-dense h-100">
                    <abp-card-header><strong>@L["Warranty:Product"]</strong></abp-card-header>
                    <abp-card-body>
                        <div><strong>@Model.Asset.ProductCode</strong></div>
                        <div>@Model.Asset.ProductName</div>
                        <div class="text-muted mt-2">@L["Warranty:Order"]: @Model.Asset.OrderNo</div>
                    </abp-card-body>
                </abp-card>
            </div>
            <div class="col-lg-8">
                <abp-card class="vpl-card-dense h-100">
                    <abp-card-header><strong>@L["Warranty:InstallationDetails"]</strong></abp-card-header>
                    <abp-card-body>
                        <div class="row g-3">
                            <div class="col-md-4"><abp-input asp-for="Input.InstalledAt" type="datetime-local" /></div>
                            <div class="col-md-4"><abp-input asp-for="Input.SerialNo" /></div>
                            <div class="col-md-4">
                                <label class="form-label">@L["Warranty:Technician"]</label>
                                <input class="form-control" value="@Model.TechnicianName" readonly />
                            </div>
                            <div class="col-12"><abp-input asp-for="Input.InstallationAddress" /></div>
                        </div>
                    </abp-card-body>
                </abp-card>
            </div>
        </div>

        <abp-card class="vpl-card-dense mb-3">
            <abp-card-header class="d-flex justify-content-between align-items-center">
                <strong>@L["Warranty:ActualPositions"]</strong>
                <button type="button" class="btn btn-outline-primary btn-sm" id="AddInstallationPosition">
                    <i class="fa fa-plus"></i> @L["Warranty:AddPosition"]
                </button>
            </abp-card-header>
            <abp-card-body>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 6rem">@L["Warranty:IsIncluded"]</th>
                                <th style="min-width: 9rem">@L["Warranty:PositionCode"]</th>
                                <th style="min-width: 13rem">@L["Warranty:PositionName"]</th>
                                <th style="min-width: 20rem">@L["Warranty:Component"]</th>
                                <th style="width: 7rem">@L["Warranty:Quantity"]</th>
                                <th style="min-width: 12rem">@L["Warranty:Note"]</th>
                                <th style="width: 3rem"></th>
                            </tr>
                        </thead>
                        <tbody id="InstallationPositionsBody">
                            @for (var i = 0; i < Model.Input.Positions.Count; i++)
                            {
                                <tr data-installation-position>
                                    <td class="text-center">
                                        <input asp-for="Input.Positions[i].Id" type="hidden" />
                                        <input asp-for="Input.Positions[i].IsIncluded" class="form-check-input" />
                                    </td>
                                    <td><input asp-for="Input.Positions[i].PositionCode" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="Input.Positions[i].PositionName" class="form-control form-control-sm" /></td>
                                    <td><select asp-for="Input.Positions[i].ComponentId" asp-items="Model.ComponentOptions" class="form-select form-select-sm js-installation-component"></select></td>
                                    <td><input asp-for="Input.Positions[i].Quantity" type="number" min="1" step="1" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="Input.Positions[i].Note" class="form-control form-control-sm" /></td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-remove-installation-position title="@L["Delete"]">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </abp-card-body>
        </abp-card>

        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-secondary" asp-page="/Warranty/PendingInstallations">@L["Cancel"]</a>
            <button class="btn btn-primary" type="submit">
                <i class="fa fa-check"></i> @L["Warranty:ConfirmInstallation"]
            </button>
        </div>
    </form>

    <template id="InstallationPositionTemplate">
        <tr data-installation-position>
            <td class="text-center">
                <input type="checkbox" name="Input.Positions[__index__].IsIncluded" value="true" class="form-check-input" checked />
                <input type="hidden" name="Input.Positions[__index__].IsIncluded" value="false" />
            </td>
            <td><input name="Input.Positions[__index__].PositionCode" class="form-control form-control-sm" required maxlength="64" /></td>
            <td><input name="Input.Positions[__index__].PositionName" class="form-control form-control-sm" required maxlength="256" /></td>
            <td>
                <select name="Input.Positions[__index__].ComponentId" class="form-select form-select-sm js-installation-component">
                    @foreach (var option in Model.ComponentOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </select>
            </td>
            <td><input name="Input.Positions[__index__].Quantity" type="number" min="1" step="1" value="1" class="form-control form-control-sm" required /></td>
            <td><input name="Input.Positions[__index__].Note" class="form-control form-control-sm" maxlength="512" /></td>
            <td class="text-center">
                <button type="button" class="btn btn-outline-danger btn-sm" data-remove-installation-position title="@L["Delete"]">
                    <i class="fa fa-trash"></i>
                </button>
            </td>
        </tr>
    </template>
</div>
