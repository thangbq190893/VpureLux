@page "{id:guid}"
@model VPureLux.Web.Pages.Warranty.Assets.DetailsModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<VPureLux.Localization.VPureLuxResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@using VPureLux.Permissions
@{ ViewData["Title"] = L["Warranty:AssetDetails"]; }
@section scripts { <abp-script src="/Pages/Warranty/Assets/Details.js" /> }

<div class="vpl-page" data-customer-asset-details data-asset-id="@Model.Asset.Id">
    <div class="vpl-page-header d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="vpl-page-title mb-1">@Model.Asset.AssetNo</h2><div class="text-muted">@Model.Asset.CustomerCode - @Model.Asset.CustomerName</div></div>
        <div class="d-flex gap-2">
            @if ((await AuthorizationService.AuthorizeAsync(User, null, VPureLuxPermissions.Service.Create)).Succeeded)
            {
                <a class="btn btn-success btn-sm" asp-page="/Service/Create" asp-route-asset-id="@Model.Asset.Id"><i class="fa fa-screwdriver-wrench"></i> @L["Service:CreateFromAsset"]</a>
            }
            @if (Model.Asset.Source == VPureLux.Warranty.CustomerAssetSource.External)
            {
                <a class="btn btn-primary btn-sm" asp-page="/Warranty/Assets/Edit" asp-route-id="@Model.Asset.Id"><i class="fa fa-pen"></i> @L["Edit"]</a>
            }
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Warranty/Assets/Index"><i class="fa fa-arrow-left"></i> @L["Back"]</a>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <abp-card class="vpl-card-dense h-100"><abp-card-body>
                <dl class="row mb-0">
                    <dt class="col-5">@L["Warranty:Source"]</dt><dd class="col-7">@L[$"Warranty:Source:{Model.Asset.Source}"]</dd>
                    <dt class="col-5">@L["Warranty:Brand"]</dt><dd class="col-7">@Model.Asset.Brand</dd>
                    <dt class="col-5">@L["Warranty:Model"]</dt><dd class="col-7">@Model.Asset.Model</dd>
                    <dt class="col-5">@L["Warranty:SerialNo"]</dt><dd class="col-7">@Model.Asset.SerialNo</dd>
                    <dt class="col-5">@L["Warranty:InstallationAddress"]</dt><dd class="col-7">@Model.Asset.InstallationAddress</dd>
                    <dt class="col-5">@L["Warranty:ExternalReference"]</dt><dd class="col-7">@Model.Asset.ExternalReference</dd>
                </dl>
            </abp-card-body></abp-card>
        </div>
        <div class="col-lg-7">
            <abp-card class="vpl-card-dense h-100"><abp-card-header><strong>@L["Warranty:ActualPositions"]</strong></abp-card-header><abp-card-body>
                <div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light"><tr><th>@L["Warranty:PositionCode"]</th><th>@L["Warranty:PositionName"]</th><th>@L["Warranty:Component"]</th><th>@L["Warranty:Quantity"]</th><th>@L["Warranty:ReplacementBaselineDate"]</th></tr></thead>
                    <tbody>
                    @foreach (var position in Model.Asset.Positions)
                    {
                        <tr>
                            <td>@position.PositionCode</td><td>@position.PositionName</td>
                            <td>@(position.ComponentId.HasValue ? $"{position.ComponentCode} - {position.ComponentName}" : L["Warranty:MissingMapping"].Value)</td>
                            <td class="text-end">@position.Quantity</td>
                            <td>@(position.ReplacementBaselineDate?.ToString("dd/MM/yyyy") ?? L["Warranty:MissingBaseline"].Value)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </abp-card-body></abp-card>
        </div>
    </div>
    <abp-card class="vpl-card-dense">
        <abp-card-header><strong>@L["Warranty:MaintenanceHistory"]</strong></abp-card-header>
        <abp-card-body>
            <abp-table id="AssetMaintenanceHistoryTable" striped-rows="true" class="vpl-table-dense">
                <thead><tr><th>@L["Warranty:OccurredAt"]</th><th>@L["Warranty:EventType"]</th><th>@L["Warranty:EventSource"]</th><th>@L["Warranty:Component"]</th><th>@L["Warranty:Note"]</th></tr></thead>
            </abp-table>
        </abp-card-body>
    </abp-card>
</div>
